// Resource overrides for the integration-test pipeline run.
//
// Fixtures under testcases/minimal/rules/ contain 1-2 mappings each, so every
// process peaks well under 100 MB RSS. The production standard profile sizes
// INFER_MAPPINGS at 16 GB against a 26 GB executor pool -- only one INFER can
// fit at a time, and the local executor has been observed to wedge after the
// first few tasks. With tiny per-task memory here we let Nextflow fan out to
// the full cpu count.
//
// Layered on top of oxo2-dataload/nextflow/nextflow.config via a second -c
// argument; activate with -profile test.

profiles {
    test {
        executor {
            name = 'local'
            cpus = 12
            memory = '8 GB'
            queueSize = 50
            pollInterval = '100ms'
        }
        process {
            cpus = 1
            memory = '256 MB'
            time = '10m'
            errorStrategy = 'terminate'
            maxRetries = 0
            cache = 'lenient'

            withName: 'DOWNLOAD_REGISTRY'                  { memory = '512 MB' }
            withName: 'SSSOM2JSON'                         { memory = '512 MB' }
            withName: 'JSON2TTL'                           { memory = '512 MB' }
            withName: 'INFER_MAPPINGS'                     { memory = '512 MB' }
            withName: 'DETERMINE_INFERENCES_TO_TRACE'      { memory = '512 MB' }
            withName: 'SPLIT_INFERENCES_TO_TRACE'          { memory = '256 MB' }
            withName: 'EXPLAIN_INFERENCES_TO_TRACE_CHUNK'  { memory = '512 MB' }
            withName: 'MERGE_CHAIN_JSON'                   { memory = '512 MB' }
            withName: 'EXPLANATIONS_TO_JSON'               { memory = '512 MB' }
        }
    }
}
