#!/bin/bash

OXO2_INFERENCES=$OXO2_DATA/inferences
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export SCRIPT_DIR

echo OXO2_INFERENCES=$OXO2_INFERENCES
echo SCRIPT_DIR=$SCRIPT_DIR

# Create output directories
mkdir -p $OXO2_DATA/assertedMappings
mkdir -p $OXO2_INFERENCES/inferredMappings
mkdir -p $OXO2_INFERENCES/inferencesToTrace
mkdir -p $OXO2_INFERENCES/inferenceChains

# Run combined 4-stage pipeline: JSON→TTL → Infer → Trace → Explain
# Per-file pipelining: each file flows through all stages independently.
start_time=$(date +%s)
echo "Using Nextflow combined pipeline for JSON→TTL, inference, tracing, and explanation"
(cd $OXO2_DATA/nextflow_logs && nextflow -log $OXO2_DATA/nextflow_logs/.nextflow.log -c $SCRIPT_DIR/nextflow/nextflow.config run $SCRIPT_DIR/inferAndExplainMappings.nf -profile ${NF_PROFILE:-standard})
end_time=$(date +%s)
elapsed=$((end_time - start_time))
echo "Nextflow Combined Pipeline: Inferences and explanations took: ${elapsed} seconds"
