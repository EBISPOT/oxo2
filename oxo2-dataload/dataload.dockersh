#!/bin/bash

echo Creating /tmp/data directories ...
mkdir /tmp/data/logs

mkdir /tmp/data/sssom
mkdir /tmp/data/mappings
mkdir /tmp/data/sssom-as-json

mkdir /tmp/data/inferences

echo !!!!!!! Download SSSOM files ...
./downloadMappings.sh $(find /mnt/config -type f) /tmp/data/sssom $@ > /tmp/data/logs/downloadMappings.log

echo !!!!!!! Convert SSSOM to JSON ...
./sssom2json.sh /tmp/data/sssom /tmp/data/sssom-as-json > /tmp/data/logs/sssom2json.log

echo !!!!!!! Create Turtle file of mappings
./oxo2-json2inferences/json2ttl.sh /tmp/data/sssom-as-json/mapping /tmp/data/inferences > /tmp/data/logs/json2ttl.log

#echo Sleep some to allow inspecting container ...



#sleep 10000