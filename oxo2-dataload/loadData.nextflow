#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

NF_PROFILE=${NF_PROFILE:-standard}
export NF_PROFILE

# Optional extra config layered on top of the base nextflow.config. The
# integration-test harness sets this to oxo2-integration-tests/nextflow-test.config
# so it can pick the `test` profile with tiny per-process resource asks.
NF_EXTRA_CONFIG_ARG=""
if [ -n "${NF_EXTRA_CONFIG:-}" ]; then
    NF_EXTRA_CONFIG_ARG="-c ${NF_EXTRA_CONFIG}"
fi
export NF_EXTRA_CONFIG_ARG

# Nextflow directories derived from NEXTFLOW_DIR
: "${NEXTFLOW_DIR:?NEXTFLOW_DIR must be set}"
NXF_WORK=$NEXTFLOW_DIR/NXF_WORK
NXF_HOME=$NEXTFLOW_DIR/NXF_HOME
NXF_TEMP=$NEXTFLOW_DIR/NXF_TEMP
NXF_CACHE_DIR=$NEXTFLOW_DIR/NXF_CACHE_DIR
NXF_LOGS=$NEXTFLOW_DIR/logs
export NXF_WORK NXF_HOME NXF_TEMP NXF_CACHE_DIR NXF_LOGS

echo SCRIPT_DIR=$SCRIPT_DIR
echo NF_PROFILE=$NF_PROFILE
echo OXO2_DATA=$OXO2_DATA
echo OXO2_CONFIG=$OXO2_CONFIG
echo NEXTFLOW_DIR=$NEXTFLOW_DIR
echo NXF_WORK=$NXF_WORK
echo NXF_HOME=$NXF_HOME

OXO2_INFERENCES=$OXO2_DATA/inferences
export OXO2_INFERENCES
SOLR_URL=${SOLR_URL:-http://localhost:8983/solr}
SOLR_SECURITY_MANAGER_ENABLED=${SOLR_SECURITY_MANAGER_ENABLED:-false}
export SOLR_URL SOLR_SECURITY_MANAGER_ENABLED

# Pin per-task heap to 4 GB. With per-file parallelism in sssom2json.nf, up to
# ~5 SSSOM2JSON JVMs run concurrently on the local executor (cpus=6, executor
# memory=22 GB), so an explicit -Xmx avoids the default JVM ergonomics letting
# each one grab ~25% of host RAM and oversubscribing the box.
export JAVA_OPTS="${JAVA_OPTS:-} -Xmx4g -XX:+ExitOnOutOfMemoryError"
rm -R $OXO2_DATA/*
rm -R $NEXTFLOW_DIR/*

mkdir -p $NXF_WORK $NXF_HOME $NXF_TEMP $NXF_CACHE_DIR $NXF_LOGS

start_time=$(date +%s)
echo "###################" downloadMappings...
$SCRIPT_DIR/downloadMappings.nextflow
end_time=$(date +%s)
elapsed=$((end_time - start_time))
echo "Download took: ${elapsed} seconds"

start_time=$(date +%s)
echo "Using Nextflow for parallel processing of SSSOM to JSON conversion"
(nextflow -log $NXF_LOGS/sssom2json.nextflow.log \
    -c $SCRIPT_DIR/nextflow/nextflow.config $NF_EXTRA_CONFIG_ARG \
    run $SCRIPT_DIR/sssom2json.nf \
    -profile $NF_PROFILE \
    -with-trace    $NXF_LOGS/sssom2json-trace.txt \
    -with-report   $NXF_LOGS/sssom2json-report.html \
    -with-timeline $NXF_LOGS/sssom2json-timeline.html)
end_time=$(date +%s)
elapsed=$((end_time - start_time))
echo "Nextflow Parallel Processing: Writing JSON took: ${elapsed} seconds"


start_time=$(date +%s)
echo  "###################"  makeInferences...
$SCRIPT_DIR/determineInferencesAndExplanations.nextflow
end_time=$(date +%s)
elapsed=$((end_time - start_time))
echo "Total inference process took: ${elapsed} seconds"

echo  "###################"  copySolrConfig...
if ! "$SCRIPT_DIR/copySolrConfig.sh"; then
    echo "Failed to copy Solr config into $SOLR_HOME" >&2
    exit 1
fi
sleep 2
echo Start solr ...
mkdir -p $OXO2_DATA/tmp
ulimit -n 65000 2>/dev/null || true
$SOLR_SCRIPT/solr start --user-managed -Djava.io.tmpdir=$OXO2_DATA/tmp

wait_for_solr_url() {
    local url=$1
    local description=$2

    for attempt in {1..60}; do
        if curl -fsS "$url" > /dev/null; then
            echo "$description is ready at $url"
            return 0
        fi
        sleep 2
    done

    echo "$description did not become ready at $url" >&2
    return 1
}

wait_for_solr_core() {
    local core=$1
    local status_file="$OXO2_DATA/tmp/${core}-status.json"

    for attempt in {1..60}; do
        if curl -fsS "$SOLR_URL/admin/cores?action=STATUS&core=$core" > "$status_file" \
            && grep -q "\"$core\"" "$status_file"; then
            echo "Solr core $core is ready"
            return 0
        fi
        sleep 2
    done

    echo "Solr core $core did not become ready" >&2
    return 1
}

if ! wait_for_solr_url "$SOLR_URL/admin/info/system" "Solr"; then
    exit 1
fi

if ! wait_for_solr_core "oxo2-mappings"; then
    exit 1
fi

if ! wait_for_solr_core "oxo2-mappingsets"; then
    exit 1
fi

run_json2solr() {
    local input_dir=$1
    local solr_url=$2

    if ! "$SCRIPT_DIR/json2solr.sh" "$input_dir" "$solr_url"; then
        echo "Failed to post $input_dir to $solr_url" >&2
        exit 1
    fi
}

start_time=$(date +%s)
echo  "###################"  json2solr mappings ...
run_json2solr "$OXO2_DATA/sssom-as-json/mapping" "$SOLR_URL/oxo2-mappings"
echo  "###################"  json2solr mappingSets ...
run_json2solr "$OXO2_DATA/sssom-as-json/mappingSet" "$SOLR_URL/oxo2-mappingsets"
end_time=$(date +%s)
elapsed=$((end_time - start_time))
echo "Writing to Solr took: ${elapsed} seconds"
sleep 20


mkdir -p $OXO2_INFERENCES/solr/mapping
mkdir -p $OXO2_INFERENCES/solr/mappingSet

start_time=$(date +%s)
echo "Using Nextflow for parallel explanations2json"
(cd $NXF_LOGS && nextflow -log $NXF_LOGS/explanations2json.nextflow.log \
    -c $SCRIPT_DIR/nextflow/nextflow.config $NF_EXTRA_CONFIG_ARG \
    run $SCRIPT_DIR/oxo2-json2inferences/explanations2json.nf \
    -profile $NF_PROFILE \
    -with-trace    $NXF_LOGS/explanations2json-trace.txt \
    -with-report   $NXF_LOGS/explanations2json-report.html \
    -with-timeline $NXF_LOGS/explanations2json-timeline.html)
end_time=$(date +%s)
elapsed=$((end_time - start_time))
echo "Nextflow Parallel Processing: explanations2json took: ${elapsed} seconds"


echo  "###################"  json2solr inferred mappings ...
run_json2solr "$OXO2_INFERENCES/solr/mapping" "$SOLR_URL/oxo2-mappings"
echo  "###################"  json2solr inferred mappingSets ...
run_json2solr "$OXO2_INFERENCES/solr/mappingSet" "$SOLR_URL/oxo2-mappingsets"
sleep 20


echo  "################### Stopping solr ..."
$SOLR_SCRIPT/solr stop -p 8983

cd ..
