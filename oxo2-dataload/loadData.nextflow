#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Auto-detect Slurm: if SLURM_JOB_ID is set, default to slurm profile
if [ -n "$SLURM_JOB_ID" ]; then
    NF_PROFILE="${NF_PROFILE:-slurm}"
    NF_CONTAINER="${NF_CONTAINER:-docker://ghcr.io/ebispot/oxo2-dataload:dev}"
else
    NF_PROFILE="${NF_PROFILE:-standard}"
fi
export NF_PROFILE
export NF_CONTAINER

# Nextflow directories derived from NEXTFLOW_DIR
: "${NEXTFLOW_DIR:?NEXTFLOW_DIR must be set}"
NXF_WORK=$NEXTFLOW_DIR/NXF_WORK
NXF_HOME=$NEXTFLOW_DIR/NXF_HOME
NXF_TEMP=$NEXTFLOW_DIR/NXF_TEMP
NXF_CACHE_DIR=$NEXTFLOW_DIR/NXF_CACHE_DIR
NXF_SINGULARITY_CACHEDIR=${HPS_PATH:-$NEXTFLOW_DIR}/NXF_SINGULARITY_CACHEDIR
NXF_LOGS=$NEXTFLOW_DIR/logs
export NXF_WORK NXF_HOME NXF_TEMP NXF_CACHE_DIR NXF_SINGULARITY_CACHEDIR NXF_LOGS

echo SCRIPT_DIR=$SCRIPT_DIR
echo NF_PROFILE=$NF_PROFILE
echo NF_CONTAINER=$NF_CONTAINER
echo OXO2_DATA=$OXO2_DATA
echo OXO2_CONFIG=$OXO2_CONFIG
echo NEXTFLOW_DIR=$NEXTFLOW_DIR
echo NXF_WORK=$NXF_WORK
echo NXF_HOME=$NXF_HOME
echo NXF_SINGULARITY_CACHEDIR=$NXF_SINGULARITY_CACHEDIR

OXO2_INFERENCES=$OXO2_DATA/inferences
export OXO2_INFERENCES
rm -R $OXO2_DATA/*

mkdir -p $NXF_WORK $NXF_HOME $NXF_TEMP $NXF_CACHE_DIR $NXF_SINGULARITY_CACHEDIR $NXF_LOGS

start_time=$(date +%s)
echo "###################" downloadMappings...
$SCRIPT_DIR/downloadMappings.nextflow
end_time=$(date +%s)
elapsed=$((end_time - start_time))
echo "Download took: ${elapsed} seconds"

start_time=$(date +%s)
echo "Using Nextflow for parallel processing of SSSOM to JSON conversion"
(nextflow -log $NXF_LOGS/.nextflow.log -c $SCRIPT_DIR/nextflow/nextflow.config run $SCRIPT_DIR/sssom2json.nf -profile $NF_PROFILE)
end_time=$(date +%s)
elapsed=$((end_time - start_time))
echo "Nextflow Parallel Processing: Writing JSON took: ${elapsed} seconds"

#
start_time=$(date +%s)
echo  "###################"  makeInferences...
$SCRIPT_DIR/determineInferencesAndExplanations.nextflow
end_time=$(date +%s)
elapsed=$((end_time - start_time))
echo "Total inference process took: ${elapsed} seconds"

echo  "###################"  copySolrConfig...
$SCRIPT_DIR/copySolrConfig.sh
sleep 2
echo Start solr ...
mkdir -p $OXO2_DATA/tmp
$SOLR_SCRIPT/solr start --user-managed -Djava.io.tmpdir=$OXO2_DATA/tmp


sleep 10
start_time=$(date +%s)
echo  "###################"  json2solr mappings ...
$SCRIPT_DIR/json2solr.sh $OXO2_DATA/sssom-as-json/mapping http://localhost:8983/solr/oxo2-mappings
echo  "###################"  json2solr mappingSets ...
$SCRIPT_DIR/json2solr.sh $OXO2_DATA/sssom-as-json/mappingSet http://localhost:8983/solr/oxo2-mappingsets
end_time=$(date +%s)
elapsed=$((end_time - start_time))
echo "Writing to Solr took: ${elapsed} seconds"
sleep 20


mkdir -p $OXO2_INFERENCES/solr

start_time=$(date +%s)
echo "Using Nextflow for parallel explanations2json"
(cd $NXF_LOGS && nextflow -log $NXF_LOGS/.nextflow.log -c $SCRIPT_DIR/nextflow/nextflow.config run $SCRIPT_DIR/oxo2-json2inferences/explanations2json.nf -profile $NF_PROFILE)
end_time=$(date +%s)
elapsed=$((end_time - start_time))
echo "Nextflow Parallel Processing: explanations2json took: ${elapsed} seconds"


 echo  "###################"  json2solr inferred mappings ...
 $SCRIPT_DIR/json2solr.sh $OXO2_INFERENCES/solr http://localhost:8983/solr/oxo2-mappings
 sleep 20


echo  "################### Stopping solr ..."
$SOLR_SCRIPT/solr stop

#Important to ensure docker does not experience errors related to write.lock.
chmod -R 777 $SOLR_HOME/*
cd ..
