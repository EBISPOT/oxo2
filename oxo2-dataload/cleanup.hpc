#!/bin/bash
# Deletes one environment's HPC dataload trees (Nextflow dirs, pipeline data, Solr index).
# OXO2_ENV selects the environment (dev, the default, or prod) via the shared loadData.env.sh —
# an unknown value fails there before anything is deleted (ADR-0050).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

. "$SCRIPT_DIR/loadData.env.sh"

echo "Cleaning up OXO2_ENV=$OXO2_ENV:"
echo "  $NEXTFLOW_DIR"
echo "  $OXO2_DATA"
echo "  $SOLR_HOME"

srun -t 1:00:00 -J "oxo2cleanUp-$OXO2_ENV" --cpus-per-task=48 --mem=8G \
    bash -c " rm -Rf $NEXTFLOW_DIR &&  rm -Rf $OXO2_DATA &&  rm -Rf $SOLR_HOME"
