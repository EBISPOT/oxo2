#!/bin/bash
# Login-node entry point for OXO2 HPC dataload.
# Validates environment and submits a single Slurm job — no computation on the login node.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

 NFS_PATH="/nfs/production/parkinso/spot/oxo2/dev"
 HPS_PATH="/hps/nobackup/parkinso/spot/oxo2/dev"
 SLURM_LOGS="$NFS_PATH/logs"
 NEXTFLOW_DIR="$HPS_PATH/nextflow"
 NF_CONTAINER="docker://ghcr.io/ebispot/oxo2-nextflow:dev"
 OXO2_CONFIG="/nfs/production/parkinso/spot/oxo2/dev/oxo2/oxo-config.json"
 OXO2_DATA="$HPS_PATH/data"
 SOLR_HOME="$HPS_PATH/solr-data"

# --- Validate required environment variables ---
missing=()
for var in OXO2_DATA OXO2_CONFIG NEXTFLOW_DIR SOLR_HOME NF_CONTAINER; do
    if [ -z "${!var:-}" ]; then
        missing+=("$var")
    fi
done

if [ ${#missing[@]} -gt 0 ]; then
    echo "ERROR: Required environment variables not set: ${missing[*]}" >&2
    echo "" >&2
    echo "Usage:" >&2
    echo "  export OXO2_DATA=/hpc/shared/oxo2/data" >&2
    echo "  export OXO2_CONFIG=/hpc/shared/oxo2/config.json" >&2
    echo "  export NEXTFLOW_DIR=/hpc/shared/oxo2/nextflow" >&2
    echo "  export SOLR_HOME=/hpc/shared/oxo2/solr" >&2
    echo "  export NF_CONTAINER=docker://ghcr.io/ebispot/oxo2-nextflow:dev" >&2
    echo "  $0" >&2
    exit 1
fi

# --- Configurable Slurm resources ---
# 32G: main batch step hosts the Solr singularity instance, the Nextflow driver JVM,
# and (when a stage runs inline) the worker JVM. 16G was not enough for NCBI taxon.
HPC_TIME="${HPC_TIME:-72:00:00}"
HPC_MEM="${HPC_MEM:-32G}"
# 8 CPUs: the main batch step runs Solr, the Nextflow driver, and inline json2solr indexing,
# and at the end compresses $SOLR_HOME with pigz (parallel gzip), which scales with cores.
# pigz is run with -p $SLURM_CPUS_PER_TASK in loadData.slurm, so it tracks this value.
HPC_CPUS="${HPC_CPUS:-8}"

# --- Resume point (see oxo2-dataload/CONTEXT.md § Resumable dataload) ---
# download (default) = full run; any later (sub)stage resumes from there, reusing earlier stages'
# published artifacts. loadData.slurm validates the value against its STAGES list.
START_STAGE="${START_STAGE:-download}"

# --- Create log directory ---
mkdir -p "$SLURM_LOGS"
rm -rf "$SLURM_LOGS"/*

# --- Check for new Singularity image ---
SIF_DIGEST_FILE="$NFS_PATH/oxo2-nextflow.digest"
REMOTE_DIGEST=""
GHCR_TOKEN=$(curl -sf "https://ghcr.io/token?scope=repository:ebispot/oxo2-nextflow:pull" | jq -r '.token' 2>/dev/null) || true
if [ -n "$GHCR_TOKEN" ]; then
    HEADER_TMP=$(mktemp)
    curl -sf -D "$HEADER_TMP" -o /dev/null \
        -H "Authorization: Bearer $GHCR_TOKEN" \
        -H "Accept: application/vnd.oci.image.index.v1+json" \
        https://ghcr.io/v2/ebispot/oxo2-nextflow/manifests/dev || true
    REMOTE_DIGEST=$(sed -n 's/^[Dd]ocker-[Cc]ontent-[Dd]igest: *\([^ ]*\).*/\1/Ip' "$HEADER_TMP") || true
    rm -f "$HEADER_TMP"
fi
echo "Remote image digest: ${REMOTE_DIGEST:-not available}"

# --- Build sbatch arguments ---
SBATCH_ARGS=(
    --time="$HPC_TIME"
    --mem="$HPC_MEM"
    --cpus-per-task="$HPC_CPUS"
    --output="$SLURM_LOGS/oxo2-dataload-%j.out"
    --error="$SLURM_LOGS/oxo2-dataload-%j.err"
    --export="SCRIPT_DIR=$SCRIPT_DIR,OXO2_DATA=$OXO2_DATA,OXO2_CONFIG=$OXO2_CONFIG,NEXTFLOW_DIR=$NEXTFLOW_DIR,SOLR_HOME=$SOLR_HOME,NF_CONTAINER=$NF_CONTAINER,SIF_DIGEST_FILE=$SIF_DIGEST_FILE,START_STAGE=$START_STAGE${HPC_PATH:+,HPC_PATH=$HPC_PATH}${REMOTE_DIGEST:+,REMOTE_DIGEST=$REMOTE_DIGEST}"
)

if [ -n "${HPC_ACCOUNT:-}" ]; then
    SBATCH_ARGS+=(--account="$HPC_ACCOUNT")
fi

# --- Submit the job ---
echo "Submitting OXO2 dataload job..."
echo "  Start stage: $START_STAGE"
echo "  Time limit: $HPC_TIME"
echo "  Memory: $HPC_MEM"
echo "  CPUs: $HPC_CPUS"
echo "  Container: $NF_CONTAINER"
echo "  Data dir: $OXO2_DATA"
echo "  Config: $OXO2_CONFIG"
echo "  Nextflow dir: $NEXTFLOW_DIR"
echo "  Solr home: $SOLR_HOME"
echo "  Slurm logs: $SLURM_LOGS"

# --parsable -> the bare job id on stdout. We also emit machine-readable OXO2_JOB_* lines so the
# Jenkins wrapper (loadData.jenkins.sh) can parse the id and the log paths to follow/poll the run.
OXO2_JOB_ID=$(sbatch --parsable "${SBATCH_ARGS[@]}" "$SCRIPT_DIR/loadData.slurm")
echo "Submitted batch job $OXO2_JOB_ID"
echo "OXO2_JOB_ID=$OXO2_JOB_ID"
echo "OXO2_JOB_OUT=$SLURM_LOGS/oxo2-dataload-$OXO2_JOB_ID.out"
echo "OXO2_JOB_ERR=$SLURM_LOGS/oxo2-dataload-$OXO2_JOB_ID.err"

