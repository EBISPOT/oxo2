#!/bin/bash
# Login-node entry point for OXO2 HPC dataload.
# Validates environment and submits a single Slurm job — no computation on the login node.
#
# OXO2_ENV selects the target environment (dev, the default, or prod): the shared
# loadData.env.sh derives every path and the container image from it, and any explicitly
# exported variable overrides its derived default. A production submission is
#
#   OXO2_ENV=prod ./loadData.hpc

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Shared dev/prod environment derivation — also sourced by loadData.jenkins.sh and cleanup.hpc,
# so the entry points cannot disagree on where an environment lives (ADR-0050).
. "$SCRIPT_DIR/loadData.env.sh"

# --- Validate required environment variables ---
# loadData.env.sh always assigns these, so this can only fire on a broken edit of the
# derivation — kept as a cheap regression net.
missing=()
for var in OXO2_DATA OXO2_CONFIG NEXTFLOW_DIR SOLR_HOME NF_CONTAINER; do
    if [ -z "${!var:-}" ]; then
        missing+=("$var")
    fi
done

if [ ${#missing[@]} -gt 0 ]; then
    echo "ERROR: Required environment variables not set: ${missing[*]}" >&2
    echo "" >&2
    echo "These normally come from loadData.env.sh (OXO2_ENV=$OXO2_ENV); export any of them" >&2
    echo "explicitly to override the derived defaults." >&2
    exit 1
fi

# --- Configurable Slurm resources ---
# 32G: main batch step hosts the Solr singularity instance, the Nextflow driver JVM,
# and (when a stage runs inline) the worker JVM. 16G was not enough for NCBI taxon.
HPC_TIME="${HPC_TIME:-72:00:00}"
HPC_MEM="${HPC_MEM:-32G}"
# 8 CPUs: the main batch step runs Solr, the Nextflow driver, and inline json2solr indexing,
# and at the end compresses $SOLR_HOME with pigz (parallel gzip), which scales with cores.
# pigz is run with -p $SLURM_CPUS_PER_TASK in loadData.slurm, so it tracks this value.
HPC_CPUS="${HPC_CPUS:-8}"
# Heap for the Solr instance the batch step hosts. Solr's launcher otherwise defaults to a
# fixed 512m, which OOM-crashed the JVM at dev-corpus scale during index-entities (job
# 29435209, 2026-08-27). 4g = parity with startSolr.sh / loadData.nextflow; must stay well
# inside HPC_MEM alongside the Nextflow driver and inline stages.
SOLR_HEAP="${SOLR_HEAP:-4g}"

# --- Resume point (see oxo2-dataload/CONTEXT.md § Resumable dataload) ---
# download (default) = full run; any later (sub)stage resumes from there, reusing earlier stages'
# published artifacts. loadData.slurm validates the value against its STAGES list.
START_STAGE="${START_STAGE:-download}"

# --- Create log directory ---
mkdir -p "$SLURM_LOGS"
rm -rf "$SLURM_LOGS"/*

# --- Check for new Singularity image ---
# The repository path and tag are parsed out of NF_CONTAINER so the digest probe follows the
# image actually configured (an explicit NF_CONTAINER override included) instead of a hardcoded
# dev tag. A non-GHCR ref just fails the token request, degrading to "not available", which the
# compute node treats as "keep the cached image".
IMAGE_REF="${NF_CONTAINER#docker://}"                              # ghcr.io/ebispot/oxo2-nextflow:<tag>
IMAGE_TAG="${IMAGE_REF##*:}"
IMAGE_PATH="${IMAGE_REF%:*}"; IMAGE_PATH="${IMAGE_PATH#ghcr.io/}"  # ebispot/oxo2-nextflow
SIF_DIGEST_FILE="$NFS_PATH/oxo2-nextflow.digest"
REMOTE_DIGEST=""
GHCR_TOKEN=$(curl -sf "https://ghcr.io/token?scope=repository:$IMAGE_PATH:pull" | jq -r '.token' 2>/dev/null) || true
if [ -n "$GHCR_TOKEN" ]; then
    HEADER_TMP=$(mktemp)
    curl -sf -D "$HEADER_TMP" -o /dev/null \
        -H "Authorization: Bearer $GHCR_TOKEN" \
        -H "Accept: application/vnd.oci.image.index.v1+json" \
        "https://ghcr.io/v2/$IMAGE_PATH/manifests/$IMAGE_TAG" || true
    REMOTE_DIGEST=$(sed -n 's/^[Dd]ocker-[Cc]ontent-[Dd]igest: *\([^ ]*\).*/\1/Ip' "$HEADER_TMP") || true
    rm -f "$HEADER_TMP"
fi
echo "Remote image digest: ${REMOTE_DIGEST:-not available}"

# --- Build sbatch arguments ---
# The per-environment job name overrides loadData.slurm's #SBATCH header so dev and prod runs
# are distinguishable in squeue.
SBATCH_ARGS=(
    --job-name="oxo2-dataload-$OXO2_ENV"
    --time="$HPC_TIME"
    --mem="$HPC_MEM"
    --cpus-per-task="$HPC_CPUS"
    --output="$SLURM_LOGS/oxo2-dataload-%j.out"
    --error="$SLURM_LOGS/oxo2-dataload-%j.err"
    --export="SCRIPT_DIR=$SCRIPT_DIR,OXO2_DATA=$OXO2_DATA,OXO2_CONFIG=$OXO2_CONFIG,NEXTFLOW_DIR=$NEXTFLOW_DIR,SOLR_HOME=$SOLR_HOME,NF_CONTAINER=$NF_CONTAINER,SIF_DIGEST_FILE=$SIF_DIGEST_FILE,START_STAGE=$START_STAGE,SOLR_HEAP=$SOLR_HEAP${HPC_PATH:+,HPC_PATH=$HPC_PATH}${REMOTE_DIGEST:+,REMOTE_DIGEST=$REMOTE_DIGEST}"
)

if [ -n "${HPC_ACCOUNT:-}" ]; then
    SBATCH_ARGS+=(--account="$HPC_ACCOUNT")
fi

# --- Submit the job ---
echo "Submitting OXO2 dataload job..."
echo "  Environment: $OXO2_ENV"
echo "  Start stage: $START_STAGE"
echo "  Time limit: $HPC_TIME"
echo "  Memory: $HPC_MEM"
echo "  CPUs: $HPC_CPUS"
echo "  Solr heap: $SOLR_HEAP"
echo "  Container: $NF_CONTAINER"
echo "  Data dir: $OXO2_DATA"
echo "  Config: $OXO2_CONFIG"
echo "  Nextflow dir: $NEXTFLOW_DIR"
echo "  Solr home: $SOLR_HOME"
echo "  Slurm logs: $SLURM_LOGS"

# --parsable -> the bare job id on stdout. We also emit machine-readable OXO2_JOB_* lines so the
# Jenkins wrapper (loadData.jenkins.sh) can parse the id and the log paths to follow/poll the run.
OXO2_JOB_ID=$(sbatch --parsable "${SBATCH_ARGS[@]}" "$SCRIPT_DIR/loadData.slurm")
echo "Submitted batch job $OXO2_JOB_ID"
echo "OXO2_JOB_ID=$OXO2_JOB_ID"
echo "OXO2_JOB_OUT=$SLURM_LOGS/oxo2-dataload-$OXO2_JOB_ID.out"
echo "OXO2_JOB_ERR=$SLURM_LOGS/oxo2-dataload-$OXO2_JOB_ID.err"

