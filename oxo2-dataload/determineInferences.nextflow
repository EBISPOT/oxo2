#!/bin/bash

OXO2_INFERENCES=$OXO2_DATA/inferences
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export SCRIPT_DIR

echo OXO2_INFERENCES=$OXO2_INFERENCES
echo SCRIPT_DIR=$SCRIPT_DIR

# Create output directories. The single SSSOM pass (ADR-0016) converts each set's JSON to N-Quads,
# concatenates them into one corpus, and infers (sssom.rls) -> a single inferred-mappings TTL
# (inferences.ttl). No trace/explain: explanations are deferred to on-demand (ADR-0020).
mkdir -p $OXO2_DATA/assertedMappings
mkdir -p $OXO2_INFERENCES/crossSet

# Optional extra config layered on top of the base nextflow.config (test harness
# uses this to pick the `test` profile in oxo2-integration-tests/nextflow-test.config).
NF_EXTRA_CONFIG_ARG=""
if [ -n "${NF_EXTRA_CONFIG:-}" ]; then
    NF_EXTRA_CONFIG_ARG="-c ${NF_EXTRA_CONFIG}"
fi

# Resume support (ADR-0019): when the orchestrator resumes at START_STAGE=infer, re-enter the DAG at
# INFER via `-entry from_infer`, reading the previously PUBLISHED assertedCorpus.nq instead of
# rebuilding N-Quads from JSON. Any other START_STAGE (download|sssom2json|nquads, or unset) runs the
# default workflow {} from each set's JSON. Mirrors the entry selection in loadData.slurm.
INFER_ENTRY_ARGS=()
case "${START_STAGE:-download}" in
    infer) INFER_ENTRY_ARGS=(-entry from_infer) ;;
esac

# SSSOM reasoning across all mapping sets (ADR-0016): JSON -> N-Quads -> concatenate corpus ->
# Infer (sssom.rls) -> inferences.ttl (the inferred mappings; no trace/explain, ADR-0020).
start_time=$(date +%s)
echo "Inference: SSSOM reasoning across all mapping sets (inferSssomCrossSet.nf, entry=${START_STAGE:-download})"
(nextflow -log $NXF_LOGS/inferSssomCrossSet.nextflow.log \
    -c $SCRIPT_DIR/nextflow/nextflow.config $NF_EXTRA_CONFIG_ARG \
    run $SCRIPT_DIR/inferSssomCrossSet.nf \
    -profile ${NF_PROFILE:-standard} \
    ${INFER_ENTRY_ARGS[@]+"${INFER_ENTRY_ARGS[@]}"} \
    -with-trace    $NXF_LOGS/inferSssomCrossSet-trace.txt \
    -with-report   $NXF_LOGS/inferSssomCrossSet-report.html \
    -with-timeline $NXF_LOGS/inferSssomCrossSet-timeline.html)
end_time=$(date +%s)
elapsed=$((end_time - start_time))
echo "SSSOM cross-set inference took: ${elapsed} seconds"
