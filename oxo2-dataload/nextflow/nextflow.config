workDir = "${System.getenv('NXF_WORK')}"

// Process default configuration
process {
    cpus = 1
    memory = '8 GB'
    time = '2h'

    errorStrategy = 'ignore'
    maxRetries = 1

    cache = 'lenient'
}

profiles {
    standard {
        executor {
            name = 'local'
            cpus = 12
            memory = '24 GB'
            queueSize = 12
        }
        process {
            withName: 'SSSOM2JSON' {
                memory = '2 GB'
                time = '2h'
            }
            withName: 'JSON2NQUADS' {
                memory = '2 GB'
                cpus = 1
            }
            withName: 'INFER_MAPPINGS' {
                memory = '2 GB'
                time = '4h'
                cpus = 1
            }
            withName: 'DETERMINE_INFERENCES_TO_TRACE' {
                memory = '1 GB'
                cpus = 1
            }
            withName: 'SPLIT_INFERENCES_TO_TRACE' {
                memory = '1 GB'
                cpus = 1
                time = '30m'
            }
            withName: 'EXPLAIN_INFERENCES_TO_TRACE_CHUNK' {
                // nmo is single-threaded here (~100% CPU in every trace row), so cpus=1 lets
                // the local executor pack chunks up to the memory pool instead of serialising
                // them — cpus=10 on a 12-core executor forced one chunk at a time.
                cpus = 1
                // Heap is dominated by the asserted + inferred TTL graphs nmo re-loads and
                // re-materialises for every chunk (the chunk trace input is only a few MB);
                // chunks for a given set all need the same heap. ncbitaxon EXPLAIN peaks at
                // ~6.3 GB RSS on its ~4.3 GB combined files (~1.5x); ~3x combined gives ~2x-peak
                // headroom (~13 GB → packs ~1-wide in the 24 GB pool). Small sets' combined
                // files are a few MB (real RSS < 1 GB), so a 2 GB floor lets them pack to the
                // 12-core CPU limit rather than the memory limit. Mirrors the slurm profile's
                // closure but with a tighter floor — the local pool is shared and advisory.
                memory = {
                    def asserted = new File("${params.asserted_mappings_dir}/${baseName}.nq")
                    def inferred = new File("${params.inferred_mappings_dir}/${baseName}.ttl")
                    def assertedSize = asserted.exists() ? asserted.length() : 0L
                    def inferredSize = inferred.exists() ? inferred.length() : 0L
                    def predicted = (assertedSize + inferredSize) * 2L + chunk_file.size() * 120L
                    def floor = 1L * 1024L * 1024L * 1024L
                    Math.max(predicted, floor) as nextflow.util.MemoryUnit
                }
                time = '4h'
            }
            withName: 'MERGE_CHAIN_JSON' {
                cpus = 1
                memory = '2 GB'
                time = '1h'
            }
            withName: 'EXPLANATIONS_TO_JSON' {
                memory = '2 GB'
                time = '4h'
                cpus = 1
            }
            // Phase 2 (cross-set SSSOM) processes. INFER_CROSS_SET and EXPLAIN_CROSS_SET_CHUNK load
            // the concatenated all-sets corpus, so they are the heaviest; tune up for large corpora.
            withName: 'CONCAT_CORPUS' {
                memory = '2 GB'
                time = '1h'
                cpus = 1
            }
            withName: 'INFER_CROSS_SET' {
                memory = '12 GB'
                time = '4h'
            }
            withName: 'DETERMINE_CROSS_SET_TRACE' {
                memory = '2 GB'
                cpus = 1
            }
            withName: 'SPLIT_CROSS_SET_TRACE' {
                memory = '2 GB'
                time = '30m'
                cpus = 1
            }
            withName: 'EXPLAIN_CROSS_SET_CHUNK' {
                cpus = 1
                memory = '12 GB'
                time = '4h'
            }
            withName: 'MERGE_CROSS_SET_CHAIN' {
                cpus = 1
                memory = '4 GB'
                time = '1h'
            }
        }
    }

    slurm {
        params.script_dir = '/opt/oxo/oxo2-dataload'
        executor {
            name = 'slurm'
            // cpus/memory are local-executor-only directives and are ignored by the grid (slurm)
            // executor; each job's --cpus-per-task / --mem come from the per-process selectors below.
            // queueSize caps how many jobs Nextflow keeps submitted to SLURM at once. 150 lets the
            // per-set (202 sets) and per-chunk (ncbitaxon ~500 chunks) fan-out spread across the
            // 346-node cluster and lets SLURM fair-share absorb the queue.
            queueSize = 150
        }
        singularity {
            enabled = true
            autoMounts = true
            cacheDir = "${System.getenv('NXF_SINGULARITY_CACHEDIR')}"
            envWhitelist = 'SOLR_URL,no_proxy,JAVA_OPTS'
        }
        process {
            container = "${System.getenv('NF_CONTAINER')}"
            withName: 'DOWNLOAD_REGISTRY' {
                memory = '4 GB'
                time = '2h'
            }
            withName: 'SSSOM2JSON' {
                memory = '4 GB'
                time = '2h'
            }
            withName: 'JSON2NQUADS' {
                cpus = 2
                // Peak RSS is ~1.7 GB (ncbitaxon, 20260529 HPC run); 4 GB is ~2.4x headroom.
                memory = '4 GB'
                time = '2h'
            }
            withName: 'INFER_MAPPINGS' {
                // Most sets peak well under 500 MB RSS (snomed ~361 MB); ncbitaxon is the
                // outlier, peaking at 5.4 GB on its 3.4 GB asserted TTL in the 20260529 HPC
                // run. 12 GB gives ~2.2x headroom over that peak while letting SLURM pack more
                // sub-jobs per node. Realtime tops out at a few minutes (ncbitaxon ~5 min);
                // 4 h keeps wide headroom and may keep INFER_MAPPINGS eligible for shorter
                // SLURM partitions on clusters that tier by walltime.
                memory = '12 GB'
                time = '4h'
            }
            withName: 'DETERMINE_INFERENCES_TO_TRACE' {
                // Inferences2Trace streams triples from the RDF parser straight to the
                // output writer, so peak heap is bounded by parser/buffer overhead and
                // does not scale with input size. 4 GB is comfortable headroom even for
                // ncbitaxon-scale inputs.
                cpus = 2
                memory = '4 GB'
                time = '4h'
            }
            withName: 'SPLIT_INFERENCES_TO_TRACE' {
                cpus = 1
                memory = '1 GB'
                time = '30m'
            }
            withName: 'EXPLAIN_INFERENCES_TO_TRACE_CHUNK' {
                cpus = 1
                memory = {
                    // Heap is dominated by the asserted + inferred TTL graphs nemo loads,
                    // not the chunk trace input — chunks for a given set all need the same
                    // heap. INFER on ncbitaxon peaked at 5.4 GB on a 3.4 GB asserted TTL
                    // (~1.6x file size); EXPLAIN holds asserted + inferred plus chunk state,
                    // so ~3x of the combined file size covers it with headroom. Small sets
                    // stay at the 4 GB floor (SLURM accounting cheap); ncbitaxon (3.4 GB +
                    // 918 MB ≈ 4.3 GB combined) → ~13 GB, fixing the 466-chunk OOM cascade.
                    def asserted = new File("${params.asserted_mappings_dir}/${baseName}.nq")
                    def inferred = new File("${params.inferred_mappings_dir}/${baseName}.ttl")
                    def assertedSize = asserted.exists() ? asserted.length() : 0L
                    def inferredSize = inferred.exists() ? inferred.length() : 0L
                    def predicted = (assertedSize + inferredSize) * 3L + chunk_file.size() * 120L
                    def floor = 4L * 1024L * 1024L * 1024L
                    Math.max(predicted, floor) as nextflow.util.MemoryUnit
                }
                time = '4h'
            }
            withName: 'MERGE_CHAIN_JSON' {
                cpus = 1
                // MergeChainFiles loads all per-chunk chain JSON files into LinkedHashSets.
                // ncbitaxon has ~506 chunks; OOM-killed at 16 GB on 2026-05-21 (exit 137).
                // Without -Xmx the JVM claimed ~25 % of host RAM, far exceeding the cgroup
                // limit — the -Xmx fix in the script block addresses that root cause.
                // 64 GB is added as a safety ceiling for the genuine data size.
                memory = { baseName.startsWith('ncbitaxon.') ? '64 GB' : '16 GB' }
                time   = { baseName.startsWith('ncbitaxon.') ? '2h'    : '1h'    }
            }
            withName: 'EXPLANATIONS_TO_JSON' {
                // The cda46d4 rewrite (2026-05-08) "Speed up and harden EXPLANATIONS_TO_JSON
                // for large inference chains" eliminated the old OOM / walltime blowups. In the
                // 20260529 HPC run all 202 sets finished under 13 min (mean peak RSS ~467 MB,
                // tail < 1 GB). snomed and vto are still the heaviest at 12.9 GB / 11.0 GB; ncit
                // and tto trail at ~3.5 GB. These four keep a raised 32 GB tier (~2.5x snomed) so
                // the long tail of small sets stays at 16 GB and packs densely. Walltime no
                // longer needs tiering: 12 h is ~57x the 12.6 min worst case.
                memory = { ['snomed','vto','tto','ncit'].any { input_file.baseName.startsWith(it + '.') } ? '32 GB' : '16 GB' }
                time   = '12h'
            }
            // Phase 2 (cross-set SSSOM) processes. These have not yet run at full scale on HPC —
            // the only trace is a 2-set local toy corpus (peaks of 7-57 MB), which cannot be
            // extrapolated to 202 sets. The run-once jobs (CONCAT/INFER/DETERMINE/SPLIT/MERGE) keep
            // generous fixed ceilings; over-provisioning a singleton that runs once is nearly free
            // and all fit a 376 GB node. EXPLAIN_CROSS_SET_CHUNK is the only fan-out process, so it
            // gets an adaptive closure (below) instead of a flat guess. RECALIBRATE all of these to
            // ~2x observed peak RSS after the first real HPC run captures cross-set traces.
            withName: 'CONCAT_CORPUS' {
                cpus = 1
                memory = '4 GB'
                time = '2h'
            }
            withName: 'INFER_CROSS_SET' {
                cpus = 1
                memory = '32 GB'
                time = '8h'
            }
            withName: 'DETERMINE_CROSS_SET_TRACE' {
                cpus = 2
                memory = '4 GB'
                time = '4h'
            }
            withName: 'SPLIT_CROSS_SET_TRACE' {
                cpus = 1
                memory = '1 GB'
                time = '30m'
            }
            withName: 'EXPLAIN_CROSS_SET_CHUNK' {
                cpus = 1
                // Mirrors the per-set EXPLAIN closure, keyed on the single cross-set corpus instead
                // of a per-set baseName: nemo re-loads the concatenated all-sets corpus and
                // re-materialises the inferred graph for every chunk (the chunk trace input is only
                // a few MB). Both files exist on disk before EXPLAIN is scheduled (CONCAT_CORPUS and
                // INFER_CROSS_SET publish them), so the closure can stat them. The 3x factor is
                // inherited from the per-set OWL EXPLAIN; SSSOM cross-set reasoning may differ, so
                // recalibrate to ~2x peak after the first HPC run. 8 GB floor covers a small corpus.
                memory = {
                    def corpus = new File("${params.corpus_file}")
                    def inferred = new File("${params.cross_set_dir}/${params.inferred_set_basename}.ttl")
                    def corpusSize = corpus.exists() ? corpus.length() : 0L
                    def inferredSize = inferred.exists() ? inferred.length() : 0L
                    def predicted = (corpusSize + inferredSize) * 3L + chunk_file.size() * 120L
                    def floor = 8L * 1024L * 1024L * 1024L
                    Math.max(predicted, floor) as nextflow.util.MemoryUnit
                }
                time = '8h'
            }
            withName: 'MERGE_CROSS_SET_CHAIN' {
                cpus = 1
                memory = '32 GB'
                time = '2h'
            }
        }
    }
}

// Report / timeline / trace filenames are passed per-invocation via
// -with-report / -with-timeline / -with-trace so each pipeline stage in
// loadData.slurm writes to its own file instead of overwriting a shared one.
report   { enabled = true; overwrite = true }
timeline { enabled = true; overwrite = true }
trace    {
    enabled = true
    overwrite = true
    fields = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,%cpu,memory,peak_rss,peak_vmem,rchar,wchar'
}
