workDir = "${System.getenv('OXO2_DATA')}/nextflow_work"

// Executor configuration for parallel processing
executor {
    name = 'local'
    // maxForks is controlled via command-line options (see loadData.nextflow)
    // Use NEXTFLOW_MAX_FORKS environment variable to control parallelism
}

// Process default configuration
process {
    // Default resource allocation for all processes
    cpus = 1
    memory = '2 GB'
    time = '2h'
    
    // Error handling
    errorStrategy = 'retry'
    maxRetries = 2
    
    // Enable process caching for idempotent operations
    cache = 'lenient'
}

// Report configuration
report {
    enabled = true
}

// Timeline configuration
timeline {
    enabled = true
}

// Trace configuration
trace {
    enabled = true
}