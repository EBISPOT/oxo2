workDir = "${System.getenv('NXF_WORK')}"

// Process default configuration
process {
    cpus = 1
    memory = '8 GB'
    time = '2h'

    errorStrategy = 'ignore'
    maxRetries = 1

    cache = 'lenient'
}

profiles {
    standard {
        executor {
            name = 'local'
            cpus = 12
            memory = '24 GB'
            queueSize = 12
        }
        process {
            withName: 'SSSOM2JSON' {
                memory = '2 GB'
                time = '2h'
            }
            withName: 'JSON2NQUADS' {
                memory = '2 GB'
                cpus = 1
            }
            withName: 'EXPLANATIONS_TO_JSON' {
                // One bundle of shard traces -> one JSON. A swallowed failure would silently drop
                // that bundle's inferred mappings. Fail loud.
                errorStrategy = 'terminate'
                memory = '8 GB'
                time = '4h'
                cpus = 1
            }
            withName: 'MERGE_INFERRED_MAPPING_SETS' {
                // Reads only the per-bundle MappingSet metadata (no mappings). Losing it would drop
                // the inferred set's source union. Fail loud.
                errorStrategy = 'terminate'
                memory = '2 GB'
                time = '1h'
                cpus = 1
            }
            // Cross-set SSSOM processes. INFER_CROSS_SET loads the concatenated all-sets corpus, so
            // it is the heaviest; tune up for large corpora.
            withName: 'CONCAT_CORPUS' {
                memory = '2 GB'
                time = '1h'
                cpus = 1
            }
            withName: 'INFER_CROSS_SET' {
                memory = '12 GB'
                time = '4h'
            }
            withName: 'SHARD_CONCLUSIONS' {
                // Union-find over every strong-predicate IRI in the corpus, interned in heap
                // (4.35M entities -> ~4.7 GiB RSS, 29 s on the dev corpus). Run-once singleton whose
                // failure would leave nothing to explain. Fail loud.
                errorStrategy = 'terminate'
                memory = '12 GB'
                time = '2h'
                cpus = 1
            }
            withName: 'EXPLAIN_SHARD' {
                // One nmo process per shard. Peak RSS is set by the biggest shard's chase (~3.2 GiB
                // for the 434-node clique on the dev corpus); the median shard is a few tens of MB.
                errorStrategy = 'terminate'
                memory = '6 GB'
                time = '2h'
                cpus = 1
            }
            // Entity derivation (ADR-0034). Both read the mappings index, neither reads disk.
            withName: 'LIST_PREFIXES' {
                // One rows=0 facet. Its failure leaves nothing to shard, so fail loud.
                errorStrategy = 'terminate'
                memory = '2 GB'
                time = '1h'
                cpus = 1
            }
            withName: 'ENTITIES_FOR_PREFIX' {
                // One JVM per CURIE prefix; heap holds ONE ontology's entity map. A swallowed failure
                // would silently drop that ontology from the typeahead, so fail loud.
                errorStrategy = 'terminate'
                memory = '4 GB'
                time = '2h'
                cpus = 1
            }
        }
    }

    slurm {
        params.script_dir = '/opt/oxo/oxo2-dataload'
        executor {
            name = 'slurm'
            // cpus/memory are local-executor-only directives and are ignored by the grid (slurm)
            // executor; each job's --cpus-per-task / --mem come from the per-process selectors below.
            // queueSize caps how many jobs Nextflow keeps submitted to SLURM at once. 150 lets the
            // per-set (202 sets) and per-chunk (ncbitaxon ~500 chunks) fan-out spread across the
            // 346-node cluster and lets SLURM fair-share absorb the queue.
            queueSize = 150
        }
        singularity {
            enabled = true
            autoMounts = true
            cacheDir = "${System.getenv('NXF_SINGULARITY_CACHEDIR')}"
            envWhitelist = 'SOLR_URL,no_proxy,JAVA_OPTS'
        }
        process {
            container = "${System.getenv('NF_CONTAINER')}"
            withName: 'DOWNLOAD_REGISTRY' {
                memory = '4 GB'
                time = '2h'
            }
            withName: 'SSSOM2JSON' {
                memory = '4 GB'
                time = '2h'
            }
            withName: 'JSON2NQUADS' {
                cpus = 1
                // Peak RSS: 645 MB max across 289 sets (20260630 cross-set run) vs ~1.7 GB (ncbitaxon,
                // 20260529) — the two runs disagree ~2.6x, so HELD at 4 GB pending a 2nd run rather
                // than trimmed on one. NB loadData.slurm exports -XX:MaxRAMPercentage=75, so --mem caps
                // the JVM heap (2 GB -> ~1.5 GB heap): trimming below ~3 GB risks OOM if 1.7 GB recurs.
                memory = '4 GB'
                time = '2h'
            }
            withName: 'EXPLANATIONS_TO_JSON' {
                // One BUNDLE of shard traces (default 100) -> one JSON, with the explanation chain,
                // asserted evidence and explanation_length (ADR-0028). Heap holds that bundle's
                // OnDiskChainStore directory (~16 B/conclusion), the bounded 200k-entry sub-chain
                // LRU, and the entity cache seeded by one bulk prefetchMappingsByIds. All three scale
                // with the BUNDLE, not the corpus, so this no longer needs the old out-of-core sizing.
                //
                // errorStrategy 'terminate' (overriding the global 'ignore'): a swallowed failure
                // silently drops that bundle's inferred mappings. Fail loud.
                errorStrategy = 'terminate'
                memory = '16 GB'
                time   = '8h'
            }
            withName: 'MERGE_INFERRED_MAPPING_SETS' {
                // Reads only the per-bundle MappingSet metadata (no mappings), so it is tiny. Its
                // output is the inferred set's source union; a swallowed failure would silently ship
                // an empty union. Fail loud.
                errorStrategy = 'terminate'
                cpus = 1
                memory = '2 GB'
                time = '1h'
            }
            // Cross-set SSSOM processes. INFER_CROSS_SET loads the concatenated all-sets corpus and
            // is the heaviest run-once job. Sizes are calibrated to the first real HPC cross-set run
            // (20260630, job 57176412): peaks INFER_CROSS_SET 11.5 GB / 15 min (1 core @99%),
            // CONCAT_CORPUS 4 MB / 0.6s. Over-provisioning a run-once singleton is nearly free on a
            // 376 GB node, so INFER_CROSS_SET keeps 24 GB (~2.1x peak) for corpus-growth margin.
            withName: 'CONCAT_CORPUS' {
                cpus = 1
                // Just concatenates the per-set N-Quads; peak RSS 4 MB (20260630). 1 GB is vast headroom.
                memory = '1 GB'
                time = '2h'
            }
            withName: 'INFER_CROSS_SET' {
                cpus = 1
                memory = '24 GB'
                time = '8h'
            }
            withName: 'SHARD_CONCLUSIONS' {
                // Run-once singleton. Union-find over every strong-predicate IRI, interned in heap:
                // 4.35M entities -> 4.7 GiB RSS, 29 s on the dev corpus. loadData.slurm exports
                // -XX:MaxRAMPercentage=75, so --mem caps the heap; 16 GB gives ~12 GB heap (~2.5x
                // peak). Its failure leaves nothing to explain, so fail loud.
                errorStrategy = 'terminate'
                cpus = 1
                memory = '16 GB'
                time = '2h'
            }
            withName: 'EXPLAIN_SHARD' {
                // One nmo process per shard (3,607 on the dev corpus), so this is the stage that
                // actually fans out. Peak RSS is set by the largest shard's chase — 3.2 GiB for the
                // 434-node clique — while the median shard is tens of MB. 6 GB is ~1.9x that peak.
                // Wall is bounded by that one shard (~7 min); total is ~6.35 CPU-h across all shards.
                //
                // 'retry' rather than 'terminate': across thousands of SLURM jobs a transient node
                // failure is likely, and re-chasing one small shard is cheap. After maxRetries the
                // task fails and the workflow terminates — a shard that never produces a chain file
                // must not be silently skipped (the global default is 'ignore'), and the orchestrator's
                // `#chain files == #shards` post-condition is the backstop if it ever is.
                errorStrategy = 'retry'
                maxRetries = 2
                cpus = 1
                memory = '6 GB'
                time = '2h'
            }
            // Entity derivation (ADR-0034). Both read the mappings index over HTTP, so on SLURM they
            // run on a different node from Solr — hence the no_proxy/JAVA_OPTS exports in the .nf.
            withName: 'LIST_PREFIXES' {
                // One rows=0 facet over subject_prefix/object_prefix. Its failure leaves nothing to
                // shard, so fail loud rather than silently producing an empty collection.
                errorStrategy = 'terminate'
                cpus = 1
                memory = '2 GB'
                time = '1h'
            }
            withName: 'ENTITIES_FOR_PREFIX' {
                // One JVM per CURIE prefix. Heap holds ONE ontology's entity map (id + label + IRI +
                // three counters per distinct entity), not the corpus — that bound is the whole point
                // of sharding by prefix. UNMEASURED on the production corpus: size this from the
                // largest prefix's entity count before the first full HPC run (see ADR-0034), which a
                // facet on subject_prefix will tell you. 4 GB is a starting guess, not a measurement.
                //
                // 'terminate': a swallowed failure would silently drop one whole ontology from the
                // typeahead, which looks like "no results" rather than an error.
                errorStrategy = 'terminate'
                cpus = 1
                memory = '4 GB'
                time = '2h'
            }
        }
    }
}

// Report / timeline / trace filenames are passed per-invocation via
// -with-report / -with-timeline / -with-trace so each pipeline stage in
// loadData.slurm writes to its own file instead of overwriting a shared one.
report   { enabled = true; overwrite = true }
timeline { enabled = true; overwrite = true }
trace    {
    enabled = true
    overwrite = true
    fields = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,%cpu,memory,peak_rss,peak_vmem,rchar,wchar'
}
