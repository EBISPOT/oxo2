workDir = "${System.getenv('NXF_WORK')}"

// Process default configuration
process {
    cpus = 1
    memory = '8 GB'
    time = '2h'

    errorStrategy = 'ignore'
    maxRetries = 1

    cache = 'lenient'
}

profiles {
    standard {
        executor {
            name = 'local'
            cpus = 12
            memory = '24 GB'
            queueSize = 12
        }
        process {
            withName: 'SSSOM2JSON' {
                memory = '2 GB'
                time = '2h'
            }
            withName: 'JSON2NQUADS' {
                memory = '2 GB'
                cpus = 1
            }
            withName: 'EXPLANATIONS_TO_JSON' {
                // Fail loud: the cross-set run produces a single inferences-chains.json, so a
                // swallowed failure drops all inferred mappings (see slurm profile note).
                errorStrategy = 'terminate'
                memory = '2 GB'
                time = '4h'
                cpus = 1
            }
            // Cross-set SSSOM processes. INFER_CROSS_SET and EXPLAIN_CROSS_SET_CHUNK load
            // the concatenated all-sets corpus, so they are the heaviest; tune up for large corpora.
            withName: 'CONCAT_CORPUS' {
                memory = '2 GB'
                time = '1h'
                cpus = 1
            }
            withName: 'INFER_CROSS_SET' {
                memory = '12 GB'
                time = '4h'
            }
            withName: 'DETERMINE_CROSS_SET_TRACE' {
                memory = '2 GB'
                cpus = 1
            }
            withName: 'SPLIT_CROSS_SET_TRACE' {
                memory = '2 GB'
                time = '30m'
                cpus = 1
            }
            withName: 'EXPLAIN_CROSS_SET_CHUNK' {
                cpus = 1
                memory = '12 GB'
                time = '4h'
            }
            withName: 'MERGE_CROSS_SET_CHAIN' {
                cpus = 1
                memory = '4 GB'
                time = '1h'
            }
        }
    }

    slurm {
        params.script_dir = '/opt/oxo/oxo2-dataload'
        executor {
            name = 'slurm'
            // cpus/memory are local-executor-only directives and are ignored by the grid (slurm)
            // executor; each job's --cpus-per-task / --mem come from the per-process selectors below.
            // queueSize caps how many jobs Nextflow keeps submitted to SLURM at once. 150 lets the
            // per-set (202 sets) and per-chunk (ncbitaxon ~500 chunks) fan-out spread across the
            // 346-node cluster and lets SLURM fair-share absorb the queue.
            queueSize = 150
        }
        singularity {
            enabled = true
            autoMounts = true
            cacheDir = "${System.getenv('NXF_SINGULARITY_CACHEDIR')}"
            envWhitelist = 'SOLR_URL,no_proxy,JAVA_OPTS'
        }
        process {
            container = "${System.getenv('NF_CONTAINER')}"
            withName: 'DOWNLOAD_REGISTRY' {
                memory = '4 GB'
                time = '2h'
            }
            withName: 'SSSOM2JSON' {
                memory = '4 GB'
                time = '2h'
            }
            withName: 'JSON2NQUADS' {
                cpus = 1
                // Peak RSS is ~1.7 GB (ncbitaxon, 20260529 HPC run); 4 GB is ~2.4x headroom.
                memory = '4 GB'
                time = '2h'
            }
            withName: 'EXPLANATIONS_TO_JSON' {
                // Cross-set (ADR-0016): explanations run over a SINGLE merged inferences-chains.json
                // that is the UNION of every set's inference chains. ExplainInferredMappings now
                // streams it out-of-core (ADR-0018): one pass indexes every inference into an
                // on-disk store, then it builds one inferred mapping per final conclusion against a
                // bounded LRU, so heap no longer scales with the closure. Heap holds only the
                // in-memory hash64->offset directory (~16 bytes per inference) plus the bounded
                // cache; the record bytes live on disk in a temp file ~the size of the chains file,
                // written under the task work dir — so SCRATCH, not RAM, must have room for it.
                // 16 GB (-Xmx ~12.8 GB; the .nf sets heap to 0.8 * task.memory) covers a directory
                // for well over 100M inferences. Watch the "On-disk chain store: ... directory
                // capacity" log line and RECALIBRATE only if the directory approaches the heap.
                // (Was a 320 GB brute-force when the step loaded the whole closure into heap and
                // OOM'd at ~20 GB of chains; ADR-0018 removed that ceiling.)
                //
                // errorStrategy 'terminate' (overriding the global 'ignore'): with one cross-set
                // file, a swallowed failure here drops ALL inferred mappings silently — the exact
                // silent-loss class this pipeline is being hardened against. Fail loud.
                errorStrategy = 'terminate'
                memory = '16 GB'
                time   = '12h'
            }
            // Cross-set SSSOM processes. These have not yet run at full scale on HPC —
            // the only trace is a 2-set local toy corpus (peaks of 7-57 MB), which cannot be
            // extrapolated to 202 sets. The run-once jobs (CONCAT/INFER/DETERMINE/SPLIT/MERGE) keep
            // generous fixed ceilings; over-provisioning a singleton that runs once is nearly free
            // and all fit a 376 GB node. EXPLAIN_CROSS_SET_CHUNK is the only fan-out process, so it
            // gets an adaptive closure (below) instead of a flat guess. RECALIBRATE all of these to
            // ~2x observed peak RSS after the first real HPC run captures cross-set traces.
            withName: 'CONCAT_CORPUS' {
                cpus = 1
                memory = '4 GB'
                time = '2h'
            }
            withName: 'INFER_CROSS_SET' {
                cpus = 1
                memory = '24 GB'
                time = '8h'
            }
            withName: 'DETERMINE_CROSS_SET_TRACE' {
                cpus = 1
                memory = '4 GB'
                time = '4h'
            }
            withName: 'SPLIT_CROSS_SET_TRACE' {
                cpus = 1
                memory = '2 GB'
                time = '30m'
            }
            withName: 'EXPLAIN_CROSS_SET_CHUNK' {
                cpus = 1
                memory = '24 GB'
                time = '16h'
            }
            withName: 'MERGE_CROSS_SET_CHAIN' {
                cpus = 1
                // First HPC run OOM'd at 8 GB: the merge holds the union of every chunk's
                // inference chains in memory, the JVM hit its -Xmx (0.8 * tier = 6.4 GB) heap
                // cap and threw OutOfMemoryError (peak RSS 6.1 GB, i.e. heap-capped, not
                // cgroup-killed). 6.1 GB is therefore a floor, not the true peak. Raised to a
                // generous singleton tier (-Xmx ~25.6 GB) so the merge completes and the trace
                // yields a real peak; RECALIBRATE to ~2x that observed peak afterwards.
                memory = '32 GB'
                time = '2h'
            }
        }
    }
}

// Report / timeline / trace filenames are passed per-invocation via
// -with-report / -with-timeline / -with-trace so each pipeline stage in
// loadData.slurm writes to its own file instead of overwriting a shared one.
report   { enabled = true; overwrite = true }
timeline { enabled = true; overwrite = true }
trace    {
    enabled = true
    overwrite = true
    fields = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,%cpu,memory,peak_rss,peak_vmem,rchar,wchar'
}
