workDir = "${System.getenv('OXO2_DATA')}/nextflow_work"

// Process default configuration
process {
    cpus = 1
    memory = '2 GB'
    time = '2h'

    errorStrategy = 'retry'
    maxRetries = 2

    cache = 'lenient'
}

profiles {
    standard {
        executor {
            name = 'local'
        }
        process {
            withName: 'INFER_MAPPINGS' {
                memory = '8 GB'
            }
        }
    }

    slurm {
        executor {
            name = 'slurm'
            queueSize = 50
            submitRateLimit = '10/1min'
        }
        singularity {
            enabled = true
            autoMounts = true
        }
        process {
            container = "${System.getenv('NF_CONTAINER')}"
            withName: 'INFER_MAPPINGS' {
                memory = '128 GB'
                time = '48h'
            }
        }
    }
}

def nfLogs = "${System.getenv('OXO2_DATA')}/nextflow_logs"

report {
    enabled = true
    file = "${nfLogs}/report.html"
    overwrite = true
}
timeline {
    enabled = true
    file = "${nfLogs}/timeline.html"
    overwrite = true
}
trace {
    enabled = true
    file = "${nfLogs}/trace.txt"
    overwrite = true
}
