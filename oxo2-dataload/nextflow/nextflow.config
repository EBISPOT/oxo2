workDir = "${System.getenv('NXF_WORK')}"

// Process default configuration
process {
    cpus = 1
    memory = '8 GB'
    time = '2h'

    errorStrategy = 'ignore'
    maxRetries = 1

    cache = 'lenient'
}

profiles {
    standard {
        executor {
            name = 'local'
            cpus = 12
            memory = '24 GB'
            queueSize = 12
        }
        process {
            withName: 'SSSOM2JSON' {
                memory = '2 GB'
                time = '2h'
            }
            withName: 'JSON2NQUADS' {
                memory = '2 GB'
                cpus = 1
            }
            withName: 'INFERENCES_TO_JSON' {
                // Bare inferred-mapping build (ADR-0020): one cross-set inferences.ttl -> one JSON,
                // so a swallowed failure would drop all inferred mappings. Fail loud.
                errorStrategy = 'terminate'
                memory = '8 GB'
                time = '4h'
                cpus = 1
            }
            // Cross-set SSSOM processes. INFER_CROSS_SET loads the concatenated all-sets corpus, so
            // it is the heaviest; tune up for large corpora.
            withName: 'CONCAT_CORPUS' {
                memory = '2 GB'
                time = '1h'
                cpus = 1
            }
            withName: 'INFER_CROSS_SET' {
                memory = '12 GB'
                time = '4h'
            }
        }
    }

    slurm {
        params.script_dir = '/opt/oxo/oxo2-dataload'
        executor {
            name = 'slurm'
            // cpus/memory are local-executor-only directives and are ignored by the grid (slurm)
            // executor; each job's --cpus-per-task / --mem come from the per-process selectors below.
            // queueSize caps how many jobs Nextflow keeps submitted to SLURM at once. 150 lets the
            // per-set (202 sets) and per-chunk (ncbitaxon ~500 chunks) fan-out spread across the
            // 346-node cluster and lets SLURM fair-share absorb the queue.
            queueSize = 150
        }
        singularity {
            enabled = true
            autoMounts = true
            cacheDir = "${System.getenv('NXF_SINGULARITY_CACHEDIR')}"
            envWhitelist = 'SOLR_URL,no_proxy,JAVA_OPTS'
        }
        process {
            container = "${System.getenv('NF_CONTAINER')}"
            withName: 'DOWNLOAD_REGISTRY' {
                memory = '4 GB'
                time = '2h'
            }
            withName: 'SSSOM2JSON' {
                memory = '4 GB'
                time = '2h'
            }
            withName: 'JSON2NQUADS' {
                cpus = 1
                // Peak RSS is ~1.7 GB (ncbitaxon, 20260529 HPC run); 4 GB is ~2.4x headroom.
                memory = '4 GB'
                time = '2h'
            }
            withName: 'INFERENCES_TO_JSON' {
                // Bare inferred-mapping build (ADR-0020): one cross-set inferences.ttl -> one JSON,
                // no explanations. Far lighter than the former out-of-core explanation step — no
                // chain DAG and no on-disk store; heap holds the entity cache (curie/label keyed by
                // IRI) for the entities the inferred mappings reference, seeded by batched grouped
                // Solr queries. 16 GB is a generous starting tier; RECALIBRATE to ~2x observed peak
                // RSS after the first real HPC run.
                //
                // errorStrategy 'terminate' (overriding the global 'ignore'): one cross-set output,
                // so a swallowed failure drops ALL inferred mappings silently. Fail loud.
                errorStrategy = 'terminate'
                memory = '16 GB'
                time   = '8h'
            }
            // Cross-set SSSOM processes. INFER_CROSS_SET loads the concatenated all-sets corpus and
            // is the heaviest run-once job; over-provisioning a singleton that runs once is nearly
            // free and fits a 376 GB node. RECALIBRATE to ~2x observed peak RSS after the first real
            // HPC run.
            withName: 'CONCAT_CORPUS' {
                cpus = 1
                memory = '4 GB'
                time = '2h'
            }
            withName: 'INFER_CROSS_SET' {
                cpus = 1
                memory = '24 GB'
                time = '8h'
            }
        }
    }
}

// Report / timeline / trace filenames are passed per-invocation via
// -with-report / -with-timeline / -with-trace so each pipeline stage in
// loadData.slurm writes to its own file instead of overwriting a shared one.
report   { enabled = true; overwrite = true }
timeline { enabled = true; overwrite = true }
trace    {
    enabled = true
    overwrite = true
    fields = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,%cpu,memory,peak_rss,peak_vmem,rchar,wchar'
}
