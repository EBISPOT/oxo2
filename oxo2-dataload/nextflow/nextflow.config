workDir = "${System.getenv('NXF_WORK')}"

// Process default configuration
process {
    cpus = 1
    memory = '8 GB'
    time = '2h'

    errorStrategy = 'ignore'
    maxRetries = 1

    cache = 'lenient'
}

profiles {
    standard {
        executor {
            name = 'local'
            cpus = 6
            memory = '22 GB'
            queueSize = 20
        }
        process {
            withName: 'SSSOM2JSON' {
                memory = '4 GB'
                time = '2h'
            }
            withName: 'JSON2TTL' {
                memory = '4 GB'
                cpus = 2
            }
            withName: 'INFER_MAPPINGS' {
                // Observed peak RSS across all 8 local test sets is ~443 MB (snomed); 4 GB
                // gives ~10x headroom and lets maxForks=3 actually pack three INFER tasks
                // into the 22 GB executor pool concurrently. Slowest local realtime is ~25s
                // (vto); 30 min is generous.
                memory = '8 GB'
                time = '30m'
                maxForks = 3
                errorStrategy = 'ignore'
            }
            withName: 'DETERMINE_INFERENCES_TO_TRACE' {
                memory = '12 GB'
                cpus = 2
                maxForks = 1
            }
            withName: 'SPLIT_INFERENCES_TO_TRACE' {
                memory = '1 GB'
                time = '30m'
            }
            withName: 'EXPLAIN_INFERENCES_TO_TRACE_CHUNK' {
                // Per-chunk peak RSS observed at ~1.6 GB on VTO (100k mappings/chunk);
                // 4 GB leaves headroom and lets ~5 chunks pack into the 22 GB pool.
                memory = '4 GB'
                time = '2h'
                maxForks = 5
                errorStrategy = 'ignore'
            }
            withName: 'MERGE_CHAIN_JSON' {
                // Loads all chunk JSONs into a LinkedHashSet for dedup; for VTO that's
                // ~22 chunks × ~100 MB ≈ several GB live at the peak.
                memory = '12 GB'
                time = '30m'
                maxForks = 2
            }
            withName: 'EXPLANATIONS_TO_JSON' {
                // Observed HPC peak RSS is ~8 GB (mondo, pre-RG/RI cleanup); local test
                // data is much smaller. 8 GB allocation × maxForks=2 = 16 GB, fits in the
                // 22 GB executor pool. (At 22 GB per task only 1 task fits, defeating any
                // maxForks > 1.)
                memory = '8 GB'
                time = '4h'
                maxForks = 2
                errorStrategy = 'ignore'
            }
        }
    }

    slurm {
        params.script_dir = '/opt/oxo/oxo2-dataload'
        executor {
            name = 'slurm'
            cpus = 6
            memory = '16 GB'
            queueSize = 50
        }
        singularity {
            enabled = true
            autoMounts = true
            cacheDir = "${System.getenv('NXF_SINGULARITY_CACHEDIR')}"
            envWhitelist = 'SOLR_URL,no_proxy,JAVA_OPTS'
        }
        process {
            container = "${System.getenv('NF_CONTAINER')}"
            withName: 'DOWNLOAD_REGISTRY' {
                memory = '4 GB'
                time = '2h'
            }
            withName: 'SSSOM2JSON' {
                memory = '4 GB'
                time = '2h'
            }
            withName: 'JSON2TTL' {
                cpus = 2
                memory = '8 GB'
                time = '2h'
            }
            withName: 'INFER_MAPPINGS' {
                // Observed peak RSS across 248 HPC mapping sets is ~444 MB (snomed); 4 GB
                // gives ~10x headroom while letting SLURM pack many more sub-jobs per node.
                // Slowest realtime is ~17 min (ncbitaxon); 4 h is ~14x headroom and may keep
                // INFER_MAPPINGS eligible for shorter SLURM partitions on clusters that tier
                // by walltime.
                memory = '16 GB'
                time = '4h'
            }
            withName: 'DETERMINE_INFERENCES_TO_TRACE' {
                // Inferences2Trace streams triples from the RDF parser straight to the
                // output writer, so peak heap is bounded by parser/buffer overhead and
                // does not scale with input size. 4 GB is comfortable headroom even for
                // ncbitaxon-scale inputs.
                cpus = 2
                memory = '4 GB'
                time = '4h'
            }
            withName: 'SPLIT_INFERENCES_TO_TRACE' {
                cpus = 1
                memory = '1 GB'
                time = '30m'
            }
            withName: 'EXPLAIN_INFERENCES_TO_TRACE_CHUNK' {
                cpus = 1
                memory = {
                    // Heap is dominated by the asserted + inferred TTL graphs nemo loads,
                    // not the chunk trace input — chunks for a given set all need the same
                    // heap. INFER on ncbitaxon peaked at 5.4 GB on a 3.4 GB asserted TTL
                    // (~1.6x file size); EXPLAIN holds asserted + inferred plus chunk state,
                    // so ~3x of the combined file size covers it with headroom. Small sets
                    // stay at the 4 GB floor (SLURM accounting cheap); ncbitaxon (3.4 GB +
                    // 918 MB ≈ 4.3 GB combined) → ~13 GB, fixing the 466-chunk OOM cascade.
                    def asserted = file("${params.asserted_mappings_dir}/${baseName}.ttl")
                    def inferred = file("${params.inferred_mappings_dir}/${baseName}.ttl")
                    def assertedSize = asserted.exists() ? asserted.size() : 0L
                    def inferredSize = inferred.exists() ? inferred.size() : 0L
                    def predicted = (assertedSize + inferredSize) * 3L + chunk_file.size() * 120L
                    def floor = 4L * 1024L * 1024L * 1024L
                    Math.max(predicted, floor) as nextflow.util.MemoryUnit
                }
                time = '4h'
            }
            withName: 'MERGE_CHAIN_JSON' {
                cpus = 1
                memory = '16 GB'
                time = '1h'
            }
            withName: 'EXPLANATIONS_TO_JSON' {
                // Default 16 GB / 12 h fits ~200 sets comfortably (mean peak RSS
                // ~743 MB pre-cleanup). A handful of outliers need much more:
                //   snomed, vto — hit 12 h walltime in the 2026-05 HPC run
                //   tto         — OOM-killed at 16 GB after 1h 21m
                //   ncit        — completed at 9.5 GB / 1h 24m, close to the ceiling
                // Bumping just these avoids penalising the long tail of small sets.
                memory = { ['snomed','vto','tto','ncit'].any { input_file.baseName.startsWith(it + '.') } ? '64 GB' : '16 GB' }
                time   = { ['snomed','vto','tto','ncit'].any { input_file.baseName.startsWith(it + '.') } ? '72h'   : '12h'   }
            }
        }
    }
}

// Report / timeline / trace filenames are passed per-invocation via
// -with-report / -with-timeline / -with-trace so each pipeline stage in
// loadData.slurm writes to its own file instead of overwriting a shared one.
report   { enabled = true; overwrite = true }
timeline { enabled = true; overwrite = true }
trace    {
    enabled = true
    overwrite = true
    fields = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,%cpu,memory,peak_rss,peak_vmem,rchar,wchar'
}
