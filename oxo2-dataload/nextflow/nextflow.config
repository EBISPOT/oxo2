workDir = "${System.getenv('NXF_WORK')}"

// Process default configuration
process {
    cpus = 1
    memory = '8 GB'
    time = '2h'

    errorStrategy = 'ignore'
    maxRetries = 1

    cache = 'lenient'
}

profiles {
    standard {
        executor {
            name = 'local'
            cpus = 12
            memory = '24 GB'
            queueSize = 12
        }
        process {
            withName: 'SSSOM2JSON' {
                memory = '2 GB'
                time = '2h'
            }
            withName: 'JSON2NQUADS' {
                memory = '2 GB'
                cpus = 1
            }
            withName: 'EXPLANATIONS_TO_JSON' {
                // One bundle of shard traces -> one JSON. A swallowed failure would silently drop
                // that bundle's inferred mappings. Fail loud.
                errorStrategy = 'terminate'
                memory = '8 GB'
                time = '4h'
                cpus = 1
            }
            withName: 'MERGE_INFERRED_MAPPING_SETS' {
                // Reads only the per-bundle MappingSet metadata (no mappings). Losing it would drop
                // the inferred set's source union. Fail loud.
                errorStrategy = 'terminate'
                memory = '2 GB'
                time = '1h'
                cpus = 1
            }
            // Cross-set SSSOM processes. INFER_CROSS_SET loads the concatenated all-sets corpus, so
            // it is the heaviest; tune up for large corpora.
            withName: 'CONCAT_CORPUS' {
                memory = '2 GB'
                time = '1h'
                cpus = 1
            }
            withName: 'INFER_CROSS_SET' {
                memory = '12 GB'
                time = '4h'
            }
            withName: 'SHARD_CONCLUSIONS' {
                // Union-find over every strong-predicate IRI in the corpus, interned in heap
                // (4.35M entities -> ~4.7 GiB RSS, 29 s on the dev corpus). Run-once singleton whose
                // failure would leave nothing to explain. Fail loud.
                errorStrategy = 'terminate'
                memory = '12 GB'
                time = '2h'
                cpus = 1
            }
            withName: 'EXPLAIN_SHARD' {
                // One nmo process per shard. Peak RSS is driven by the shard's conclusion count, not
                // its corpus size: the densest shard traces 327k conclusions and peaks at ~7.74 GiB
                // (measured 2026-07-15). The local executor does NOT hard-enforce this directive — it
                // uses it only to bound concurrency against executor.memory — so an over-cap shard runs
                // to completion here; on SLURM --mem is a hard cap, so the slurm profile scales memory
                // by task.attempt instead. Kept at 6 GB so the local fan-out still packs ~4 shards at a
                // time on a 24 GB host rather than throttling on a figure only the heavy tail needs.
                errorStrategy = 'terminate'
                memory = '6 GB'
                time = '2h'
                cpus = 1
            }
            // Entity derivation (ADR-0034). Both read the mappings index, neither reads disk.
            withName: 'LIST_PREFIXES' {
                // One rows=0 facet. Its failure leaves nothing to shard, so fail loud.
                errorStrategy = 'terminate'
                memory = '2 GB'
                time = '1h'
                cpus = 1
            }
            withName: 'ENTITIES_FOR_PREFIX' {
                // One JVM per CURIE prefix; heap holds ONE ontology's entity map. A swallowed failure
                // would silently drop that ontology from the typeahead, so fail loud.
                //
                // memory scales with task.attempt HERE TOO, unlike EXPLAIN_SHARD above. That process
                // runs nmo, a native binary the local executor never caps, so a static directive only
                // bounds its concurrency. This one runs a JVM whose -Xmx mappings2entities.nf derives
                // from task.memory (0.7x) in EVERY profile, so the directive IS a hard cap locally --
                // enforced by the JVM rather than by a cgroup. cb1e2ab fixed the slurm profile and left
                // this one static on the reasoning that "the local executor does not hard-enforce
                // memory, so neither was at risk"; that is true of RSS and irrelevant to -Xmx. The
                // static 4 GB became -Xmx2867m and NCBITAXON died on it with a Java heap
                // OutOfMemoryError (2026-08-05, 26.9M-mapping corpus) -- not the cgroup SIGKILL the
                // slurm profile was hardened against, but the same shard hitting the same wall.
                //
                // Attempt 1 stays at 4 GB rather than mirroring slurm's 8 GB: the shard distribution is
                // extremely skewed (1129 prefixes, MEDIAN 1 mapping, only 7 above 500k, one above 5M),
                // and the local executor packs tasks against executor.memory, so an 8 GB attempt 1
                // would drop the whole stage from 6-wide to 3-wide to accommodate a single outlier.
                // The escalation is what fixes the outliers; the cheap first attempt is what keeps the
                // other 1122 shards fast.
                //
                // Measured on that corpus: NCBITAXON's live set is 4.84 GB (heap after GC, running to
                // completion under -Xmx5734m at 84% occupancy, peak RSS 5.86 GB, 4m06s, 2.5 GB of
                // JSON). So attempt 2 (-Xmx5734m) only just clears it today and attempt 3 (-Xmx8601m,
                // 1.8x the live set) is the real headroom as the corpus grows. Right-size from trace
                // peak_rss when this stops needing attempt 3.
                errorStrategy = 'retry'
                maxRetries = 2
                memory = { 4.GB * task.attempt }
                time = '2h'
                cpus = 1
            }
        }
    }

    slurm {
        params.script_dir = '/opt/oxo/oxo2-dataload'
        executor {
            name = 'slurm'
            // cpus/memory are local-executor-only directives and are ignored by the grid (slurm)
            // executor; each job's --cpus-per-task / --mem come from the per-process selectors below.
            // queueSize caps how many jobs Nextflow keeps submitted to SLURM at once. 150 lets the
            // per-set (202 sets) and per-chunk (ncbitaxon ~500 chunks) fan-out spread across the
            // 346-node cluster and lets SLURM fair-share absorb the queue.
            queueSize = 150
        }
        singularity {
            enabled = true
            autoMounts = true
            cacheDir = "${System.getenv('NXF_SINGULARITY_CACHEDIR')}"
            envWhitelist = 'SOLR_URL,no_proxy,JAVA_OPTS'
        }
        process {
            container = "${System.getenv('NF_CONTAINER')}"
            withName: 'DOWNLOAD_REGISTRY' {
                memory = '4 GB'
                time = '2h'
            }
            withName: 'SSSOM2JSON' {
                memory = '4 GB'
                time = '2h'
            }
            withName: 'JSON2NQUADS' {
                cpus = 1
                // Peak RSS: 645 MB max across 289 sets (20260630 cross-set run) vs ~1.7 GB (ncbitaxon,
                // 20260529) — the two runs disagree ~2.6x, so HELD at 4 GB pending a 2nd run rather
                // than trimmed on one. NB loadData.slurm exports -XX:MaxRAMPercentage=75, so --mem caps
                // the JVM heap (2 GB -> ~1.5 GB heap): trimming below ~3 GB risks OOM if 1.7 GB recurs.
                memory = '4 GB'
                time = '2h'
            }
            withName: 'EXPLANATIONS_TO_JSON' {
                // One BUNDLE of shard traces (default 100) -> one JSON, with the explanation chain,
                // asserted evidence and explanation_length (ADR-0028). Heap holds that bundle's
                // OnDiskChainStore directory (~16 B/conclusion), the bounded 200k-entry sub-chain
                // LRU, and the entity cache seeded by one bulk prefetchMappingsByIds. All three scale
                // with the BUNDLE, not the corpus, so this no longer needs the old out-of-core sizing.
                //
                // errorStrategy 'terminate' (overriding the global 'ignore'): a swallowed failure
                // silently drops that bundle's inferred mappings. Fail loud.
                errorStrategy = 'terminate'
                memory = '16 GB'
                time   = '8h'
            }
            withName: 'MERGE_INFERRED_MAPPING_SETS' {
                // Reads only the per-bundle MappingSet metadata (no mappings), so it is tiny. Its
                // output is the inferred set's source union; a swallowed failure would silently ship
                // an empty union. Fail loud.
                errorStrategy = 'terminate'
                cpus = 1
                memory = '2 GB'
                time = '1h'
            }
            // Cross-set SSSOM processes. INFER_CROSS_SET loads the concatenated all-sets corpus and
            // is the heaviest run-once job. Sizes are calibrated to the first real HPC cross-set run
            // (20260630, job 57176412): peaks INFER_CROSS_SET 11.5 GB / 15 min (1 core @99%),
            // CONCAT_CORPUS 4 MB / 0.6s. Over-provisioning a run-once singleton is nearly free on a
            // 376 GB node, so INFER_CROSS_SET keeps 24 GB (~2.1x peak) for corpus-growth margin.
            withName: 'CONCAT_CORPUS' {
                cpus = 1
                // Just concatenates the per-set N-Quads; peak RSS 4 MB (20260630). 1 GB is vast headroom.
                memory = '1 GB'
                time = '2h'
            }
            withName: 'INFER_CROSS_SET' {
                cpus = 1
                memory = '24 GB'
                time = '8h'
            }
            withName: 'SHARD_CONCLUSIONS' {
                // Run-once singleton. Union-find over every strong-predicate IRI, interned in heap:
                // 4.35M entities -> 4.7 GiB RSS, 29 s on the dev corpus. loadData.slurm exports
                // -XX:MaxRAMPercentage=75, so --mem caps the heap; 16 GB gives ~12 GB heap (~2.5x
                // peak). Its failure leaves nothing to explain, so fail loud.
                errorStrategy = 'terminate'
                cpus = 1
                memory = '16 GB'
                time = '2h'
            }
            withName: 'EXPLAIN_SHARD' {
                // One nmo process (native, no JVM) per shard, so this is the stage that fans out
                // (3,514 shards on the 2026-07-15 dev corpus). Peak RSS is set NOT by the shard's
                // corpus size but by the number of conclusions its chase traces: the densest shard
                // packs a ~1,079-entity transitive-closure component of 327,227 conclusions and peaks
                // at 7.74 GiB / 11 min wall (measured 2026-07-15). The median shard traces ~1,600
                // conclusions and is tens of MB; only 5 shards exceed 100k conclusions.
                //
                // memory scales with task.attempt so the ~3,500 light shards run cheap on attempt 1
                // (12 GiB ~= 1.5x the measured peak, covering every current shard first try) while a
                // shard whose closure has grown past that self-heals on retry (24, then 36 GiB) rather
                // than paging a human to re-tune — which is exactly how the old static 6 GB went stale
                // as the corpus grew and began OOM-killing shard00000 (SIGKILL, exit 137).
                //
                // 'retry' rather than 'terminate': across thousands of SLURM jobs a transient node
                // failure is likely, and re-chasing one shard is cheap. After maxRetries the task fails
                // and the workflow terminates — a shard that never produces a chain file must not be
                // silently skipped (the global default is 'ignore'), and the orchestrator's
                // `#chain files == #shards` post-condition is the backstop if it ever is.
                errorStrategy = 'retry'
                maxRetries = 2
                cpus = 1
                memory = { 12.GB * task.attempt }
                time = '2h'
            }
            // Entity derivation (ADR-0034). Both read the mappings index over HTTP, so on SLURM they
            // run on a different node from Solr — hence the no_proxy/JAVA_OPTS exports in the .nf.
            withName: 'LIST_PREFIXES' {
                // One rows=0 facet over subject_prefix/object_prefix. Its failure leaves nothing to
                // shard, so fail loud rather than silently producing an empty collection.
                errorStrategy = 'terminate'
                cpus = 1
                memory = '2 GB'
                time = '1h'
            }
            withName: 'ENTITIES_FOR_PREFIX' {
                // One JVM per CURIE prefix. Heap holds ONE ontology's entity map (id + label + IRI +
                // three counters per distinct entity), not the corpus — that bound is the whole point
                // of sharding by prefix, so size this from the LARGEST prefix's ENTITY count, never
                // from its mapping count or from the corpus.
                //
                // memory scales with task.attempt. The static 4 GB this replaces was never measured on
                // the shard that needed it: it extrapolated MONDO's 478 MB RSS / 33.6k entities out to
                // NCBITAXON's ~2.8M on the 28.6M-mapping dev corpus (2026-07-14), predicting ~2 GB
                // live. On the full HPC corpus that shard was SIGKILLed instead — exit 137, 3m35s in
                // (job 4695837, 2026-07-16). 137 rules the Java heap out: -XX:+ExitOnOutOfMemoryError
                // (loadData.slurm) exits 3 on heap exhaustion, so this was the cgroup OOM killer, and
                // crossing a 4 GB cap at all means G1 had grown the heap toward its 3.2 GB -Xmx —
                // i.e. the live set is ~2x the extrapolation, not ~2 GB.
                //
                // Note this could not have been fixed by measuring first. A SIGKILLed task publishes no
                // peak_rss to the trace, and its sacct MaxRSS is censored at the cap it died on, so no
                // run at 4 GB can say what the shard needs — the allocation has to lead the
                // measurement. Attempt 1 at 8 GB (-Xmx 5.6 GB) is ~2x the live set the kill implies;
                // 16 then 24 GB self-heal a shard that has outgrown even that. Once a run succeeds,
                // right-size from its trace peak_rss — that is the first honest number this stage will
                // have produced.
                //
                // 'retry' rather than 'terminate': the escalation IS the fix, so attempt 1 must not be
                // the last word. Fail-loud is unchanged — after maxRetries the task fails, the workflow
                // terminates, and loadData.slurm's `if ! nextflow run` guard exits 1, so a whole
                // ontology still cannot silently vanish from the typeahead.
                errorStrategy = 'retry'
                maxRetries = 2
                cpus = 1
                memory = { 8.GB * task.attempt }
                time = '2h'
            }
        }
    }
}

// Report / timeline / trace filenames are passed per-invocation via
// -with-report / -with-timeline / -with-trace so each pipeline stage in
// loadData.slurm writes to its own file instead of overwriting a shared one.
report   { enabled = true; overwrite = true }
timeline { enabled = true; overwrite = true }
trace    {
    enabled = true
    overwrite = true
    fields = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,%cpu,memory,peak_rss,peak_vmem,rchar,wchar'
}
