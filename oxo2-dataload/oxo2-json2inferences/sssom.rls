%! OxO2 Phase 2 — SSSOM reasoning rules, applied ACROSS ALL MAPPING SETS (ADR-0009).
%!
%! Transitivity and role chains over the STRONG mapping/equivalence predicates only. Subsumption
%! (rdfs:subClassOf/subPropertyOf, handled per-set in owl.rls) and the weak/noisy predicates
%! {skos:relatedMatch, oboInOwl:hasDbXref, skos:closeMatch, rdfs:seeAlso, rdf:type} never chain
%! here (ADR-0009). The role chains RCE1/RCE2 propagate only predicates in strongPredicate/1.
%!
%! Facts are N-Quads `<s> <p> <o> <urn:uuid:mapping_id> .` (ADR-0010); Nemo imports them in
%! graph-first order, so the mapping_id is the first term. Inferred conclusions carry the nil
%! UUID. Rules are named (#[name(...)]) so the Nemo trace identifies them by name, not body text.

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .

@parameter $importfile .
@parameter $exportfile .

@import assertedMapping :- nquads{resource=$importfile} .

% Seed: every asserted quad is a mapping, carrying its mapping_id (graph) term.
mapping(?id, ?s, ?p, ?o) :- assertedMapping(?id, ?s, ?p, ?o) .
% Projected triple view (id dropped) for the EDB-negation separation below (ADR-0010).
assertedTriple(?s, ?p, ?o) :- assertedMapping(?id, ?s, ?p, ?o) .

% The strong predicates that may chain across sets. RCE1/RCE2 propagate ONLY these; subsumption
% and weak/noisy predicates are absent here, so they never propagate (ADR-0009).
strongPredicate(owl:equivalentClass) .
strongPredicate(owl:equivalentProperty) .
strongPredicate(owl:sameAs) .
strongPredicate(skos:exactMatch) .
strongPredicate(skos:broadMatch) .
strongPredicate(skos:narrowMatch) .
strongPredicate(semapv:crossSpeciesExactMatch) .
strongPredicate(semapv:crossSpeciesBroadMatch) .
strongPredicate(semapv:crossSpeciesNarrowMatch) .

% ---- Transitivity, one rule per strong predicate ----
#[name("T1")]
mapping(<urn:uuid:00000000-0000-0000-0000-000000000000>, ?a, owl:equivalentClass, ?c) :- mapping(?id1, ?a, owl:equivalentClass, ?b), mapping(?id2, ?b, owl:equivalentClass, ?c) .
#[name("T2")]
mapping(<urn:uuid:00000000-0000-0000-0000-000000000000>, ?a, owl:equivalentProperty, ?c) :- mapping(?id1, ?a, owl:equivalentProperty, ?b), mapping(?id2, ?b, owl:equivalentProperty, ?c) .
#[name("T3")]
mapping(<urn:uuid:00000000-0000-0000-0000-000000000000>, ?a, owl:sameAs, ?c) :- mapping(?id1, ?a, owl:sameAs, ?b), mapping(?id2, ?b, owl:sameAs, ?c) .
#[name("T6")]
mapping(<urn:uuid:00000000-0000-0000-0000-000000000000>, ?a, semapv:crossSpeciesBroadMatch, ?c) :- mapping(?id1, ?a, semapv:crossSpeciesBroadMatch, ?b), mapping(?id2, ?b, semapv:crossSpeciesBroadMatch, ?c) .
#[name("T7")]
mapping(<urn:uuid:00000000-0000-0000-0000-000000000000>, ?a, semapv:crossSpeciesExactMatch, ?c) :- mapping(?id1, ?a, semapv:crossSpeciesExactMatch, ?b), mapping(?id2, ?b, semapv:crossSpeciesExactMatch, ?c) .
#[name("T8")]
mapping(<urn:uuid:00000000-0000-0000-0000-000000000000>, ?a, semapv:crossSpeciesNarrowMatch, ?c) :- mapping(?id1, ?a, semapv:crossSpeciesNarrowMatch, ?b), mapping(?id2, ?b, semapv:crossSpeciesNarrowMatch, ?c) .
#[name("T9")]
mapping(<urn:uuid:00000000-0000-0000-0000-000000000000>, ?a, skos:broadMatch, ?c) :- mapping(?id1, ?a, skos:broadMatch, ?b), mapping(?id2, ?b, skos:broadMatch, ?c) .
#[name("T10")]
mapping(<urn:uuid:00000000-0000-0000-0000-000000000000>, ?a, skos:exactMatch, ?c) :- mapping(?id1, ?a, skos:exactMatch, ?b), mapping(?id2, ?b, skos:exactMatch, ?c) .
#[name("T11")]
mapping(<urn:uuid:00000000-0000-0000-0000-000000000000>, ?a, skos:narrowMatch, ?c) :- mapping(?id1, ?a, skos:narrowMatch, ?b), mapping(?id2, ?b, skos:narrowMatch, ?c) .

% ---- Role chains over equivalence/exact-match identity edges (propagate strong predicates only) ----
% RCE1: A (owl:equivalentClass|skos:exactMatch) B, B ?p C  =>  A ?p C
#[name("RCE1-1")]
mapping(<urn:uuid:00000000-0000-0000-0000-000000000000>, ?a, ?p, ?c) :-
    mapping(?id1, ?a, owl:equivalentClass, ?b), mapping(?id2, ?b, ?p, ?c), strongPredicate(?p) .
#[name("RCE1-2")]
mapping(<urn:uuid:00000000-0000-0000-0000-000000000000>, ?a, ?p, ?c) :-
    mapping(?id1, ?a, skos:exactMatch, ?b), mapping(?id2, ?b, ?p, ?c), strongPredicate(?p) .

% RCE2: A ?p B, B (owl:equivalentClass|skos:exactMatch) C  =>  A ?p C
#[name("RCE2-1")]
mapping(<urn:uuid:00000000-0000-0000-0000-000000000000>, ?a, ?p, ?c) :-
    mapping(?id1, ?a, ?p, ?b), mapping(?id2, ?b, owl:equivalentClass, ?c), strongPredicate(?p) .
#[name("RCE2-2")]
mapping(<urn:uuid:00000000-0000-0000-0000-000000000000>, ?a, ?p, ?c) :-
    mapping(?id1, ?a, ?p, ?b), mapping(?id2, ?b, skos:exactMatch, ?c), strongPredicate(?p) .

% ---- Inverse rules for crossSpecies predicates ----
#[name("RI3")]
mapping(<urn:uuid:00000000-0000-0000-0000-000000000000>, ?b, semapv:crossSpeciesExactMatch, ?a) :- mapping(?id1, ?a, semapv:crossSpeciesExactMatch, ?b) .
#[name("RI4")]
mapping(<urn:uuid:00000000-0000-0000-0000-000000000000>, ?b, semapv:crossSpeciesBroadMatch, ?a) :- mapping(?id1, ?a, semapv:crossSpeciesNarrowMatch, ?b) .
#[name("RI5")]
mapping(<urn:uuid:00000000-0000-0000-0000-000000000000>, ?b, semapv:crossSpeciesNarrowMatch, ?a) :- mapping(?id1, ?a, semapv:crossSpeciesBroadMatch, ?b) .

% Inferred = derivable but not asserted in ANY set (EDB negation over the projected triple).
inferredMapping(?s, ?p, ?o) :- mapping(?id, ?s, ?p, ?o), ~assertedTriple(?s, ?p, ?o) .

@export inferredMapping :- turtle{resource=$exportfile} .
