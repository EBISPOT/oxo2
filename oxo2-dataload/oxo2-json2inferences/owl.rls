%! OxO2 Phase 1 — OWL reasoning rules, applied PER MAPPING SET (ADR-0009).
%!
%! Derives rdfs:subClassOf / rdfs:subPropertyOf via OWL equivalence (RCE-N1..N4) and via
%! subsumption transitivity (T4, T5). All subsumption reasoning is contained here, per set.
%!
%! Facts are N-Quads `<s> <p> <o> <urn:uuid:mapping_id> .` (ADR-0010); Nemo imports them in
%! graph-first order, so the mapping_id is the first term. Inferred conclusions carry the nil
%! UUID. Rules are named (#[name(...)]) so the Nemo trace identifies them by name, not body text.
%! These are define at: https://mapping-commons.github.io/sssom/dev/chaining-rules/ under rules that
%! "Rules that should probably not be inferred (OWL)".

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

@parameter $importfile .
@parameter $exportfile .

@import assertedMapping :- nquads{resource=$importfile} .

% Seed: every asserted quad is a mapping, carrying its mapping_id (graph) term.
mapping(?id, ?s, ?p, ?o) :- assertedMapping(?id, ?s, ?p, ?o) .
% Projected triple view (id dropped) for the EDB-negation separation below (ADR-0010).
assertedTriple(?s, ?p, ?o) :- assertedMapping(?id, ?s, ?p, ?o) .

% RCE-N1: A owl:equivalentClass B, B rdfs:subClassOf C  =>  A rdfs:subClassOf C
#[name("RCE-N1")]
mapping(<urn:uuid:00000000-0000-0000-0000-000000000000>, ?a, rdfs:subClassOf, ?c) :-
    mapping(?id1, ?a, owl:equivalentClass, ?b), mapping(?id2, ?b, rdfs:subClassOf, ?c) .

% RCE-N2: A rdfs:subClassOf B, B owl:equivalentClass C  =>  A rdfs:subClassOf C
#[name("RCE-N2")]
mapping(<urn:uuid:00000000-0000-0000-0000-000000000000>, ?a, rdfs:subClassOf, ?c) :-
    mapping(?id1, ?a, rdfs:subClassOf, ?b), mapping(?id2, ?b, owl:equivalentClass, ?c) .

% RCE-N3: A owl:equivalentProperty B, B rdfs:subPropertyOf C  =>  A rdfs:subPropertyOf C
#[name("RCE-N3")]
mapping(<urn:uuid:00000000-0000-0000-0000-000000000000>, ?a, rdfs:subPropertyOf, ?c) :-
    mapping(?id1, ?a, owl:equivalentProperty, ?b), mapping(?id2, ?b, rdfs:subPropertyOf, ?c) .

% RCE-N4: A rdfs:subPropertyOf B, B owl:equivalentProperty C  =>  A rdfs:subPropertyOf C
#[name("RCE-N4")]
mapping(<urn:uuid:00000000-0000-0000-0000-000000000000>, ?a, rdfs:subPropertyOf, ?c) :-
    mapping(?id1, ?a, rdfs:subPropertyOf, ?b), mapping(?id2, ?b, owl:equivalentProperty, ?c) .

% T4: rdfs:subClassOf transitivity
#[name("T4")]
mapping(<urn:uuid:00000000-0000-0000-0000-000000000000>, ?a, rdfs:subClassOf, ?c) :-
    mapping(?id1, ?a, rdfs:subClassOf, ?b), mapping(?id2, ?b, rdfs:subClassOf, ?c) .

% T5: rdfs:subPropertyOf transitivity
#[name("T5")]
mapping(<urn:uuid:00000000-0000-0000-0000-000000000000>, ?a, rdfs:subPropertyOf, ?c) :-
    mapping(?id1, ?a, rdfs:subPropertyOf, ?b), mapping(?id2, ?b, rdfs:subPropertyOf, ?c) .

% Inferred = derivable but not asserted in ANY set (EDB negation over the projected triple).
inferredMapping(?s, ?p, ?o) :- mapping(?id, ?s, ?p, ?o), ~assertedTriple(?s, ?p, ?o) .

@export inferredMapping :- turtle{resource=$exportfile} .
