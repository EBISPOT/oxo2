            "mainClass": "uk.ac.ebi.spot.oxo.inferences.nemo.ExplainInferredMappings",
            "projectName": "oxo2-json2inferences",
            "args": [ 
                "-i", "/home/henriette007/ebi-dev/oxo2/oxo2/data/inferences/inferenceChains/matches-all.sssom.tsv-chains.json",
