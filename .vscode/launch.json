            "vmArgs": "-Dsolr.url=http://localhost:8983/solr"            
        },
        {
            "type": "java",
            "name": "DownloadMappings",
            "request": "launch",
            "mainClass": "uk.ac.ebi.spot.oxo.downloader.DownloadMappings",
            "projectName": "oxo2-downloader",
            "args": [
                "--config", "/home/henriette007/ebi-dev/oxo2/oxo2/oxo-config.json", 
