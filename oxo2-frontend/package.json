{
  "name": "oxo2-frontend",
  "version": "2.0.0",
  "private": true,
  "dependencies": {
    "@reduxjs/toolkit": "^2.5.1",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^16.4.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.2.0",
    "react-router": "^7.1.2",
    "redux-thunk": "^3.1.0",
    "typescript": "^4.9.5",
    "url-join": "^5.0.0",
    "web-vitals": "^4.2.4"
  },
  "scripts": {
    "build": "dotenv -e .env.$REACT_APP_ENV -e .env -- node build.mjs",
    "watch": "dotenv -e .env.$REACT_APP_ENV -e .env -- nodemon -e 'ts,tsx,js,jsx,css' -w src -w index.html.in --exec 'npm run build'",
    "start": "dotenv -e .env.$REACT_APP_ENV -e .env -- concurrently -n 'Build,Serve' 'npm run watch' 'node dev_server.mjs'"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-transform-private-property-in-object": "^7.25.9",
    "concurrently": "^9.1.2",
    "dotenv-cli": "^8.0.0",
    "esbuild": "^0.24.2",
    "express": "^4.21.2",
    "express-http-proxy": "^2.1.1",
    "nocache": "^4.0.0",
    "node-fetch": "^3.3.2",
    "nodemon": "^3.1.9",
    "tailwindcss": "^3.4.17"
  }
}
